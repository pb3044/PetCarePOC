@model PetCarePlatform.Core.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
    Layout = "_PetOwnerLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Booking Details</h4>
                    <div>
                        @if (Model.Status == PetCarePlatform.Core.Models.BookingStatus.Requested || Model.Status == PetCarePlatform.Core.Models.BookingStatus.Confirmed)
                        {
                            <button type="button" class="btn btn-danger btn-sm" onclick="cancelBooking(@Model.Id)">
                                <i class="fas fa-times"></i> Cancel Booking
                            </button>
                        }
                        <a href="@Url.Action("MyBookings", "PetOwner")" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to My Bookings
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Service Information</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Service:</strong></td>
                                    <td>@Model.Service?.Title</td>
                                </tr>
                                <tr>
                                    <td><strong>Provider:</strong></td>
                                    <td>@Model.Service?.Provider?.BusinessName</td>
                                </tr>
                                <tr>
                                    <td><strong>Description:</strong></td>
                                    <td>@Model.Service?.Description</td>
                                </tr>
                                <tr>
                                    <td><strong>Price:</strong></td>
                                    <td>$@Model.TotalPrice.ToString("F2")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>Booking Information</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Booking ID:</strong></td>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td>
                                        <span class="badge badge-@(Model.Status switch {
                                            PetCarePlatform.Core.Models.BookingStatus.Requested => "warning",
                                            PetCarePlatform.Core.Models.BookingStatus.Confirmed => "info",
                                            PetCarePlatform.Core.Models.BookingStatus.InProgress => "primary",
                                            PetCarePlatform.Core.Models.BookingStatus.Completed => "success",
                                            PetCarePlatform.Core.Models.BookingStatus.Cancelled => "danger",
                                            _ => "secondary"
                                        })">
                                            @Model.Status
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Date:</strong></td>
                                    <td>@Model.StartTime.ToString("MMM dd, yyyy")</td>
                                </tr>
                                <tr>
                                    <td><strong>Time:</strong></td>
                                    <td>@Model.StartTime.ToString("h:mm tt") - @Model.EndTime.ToString("h:mm tt")</td>
                                </tr>
                                <tr>
                                    <td><strong>Pet:</strong></td>
                                    <td>@Model.Pet?.Name</td>
                                </tr>
                                <tr>
                                    <td><strong>Created:</strong></td>
                                    <td>@Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Notes</h5>
                                <p class="text-muted">@Model.Notes</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SpecialInstructions))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Special Instructions</h5>
                                <p class="text-muted">@Model.SpecialInstructions</p>
                            </div>
                        </div>
                    }

                    @if (Model.Status == PetCarePlatform.Core.Models.BookingStatus.Requested && Model.PaymentId == null)
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <h5><i class="fas fa-exclamation-triangle"></i> Payment Required</h5>
                                    <p>This booking requires payment to be confirmed.</p>
                                    <a href="@Url.Action("ProcessPayment", "Payments", new { bookingId = Model.Id })" class="btn btn-primary">
                                        <i class="fas fa-credit-card"></i> Pay Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Booking Modal -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" role="dialog" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelBookingModalLabel">Cancel Booking</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel this booking?</p>
                <div class="form-group">
                    <label for="cancellationReason">Reason for cancellation (optional):</label>
                    <textarea class="form-control" id="cancellationReason" rows="3" placeholder="Please provide a reason for cancelling this booking..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Keep Booking</button>
                <button type="button" class="btn btn-danger" onclick="confirmCancelBooking()">Cancel Booking</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let bookingIdToCancel = null;

        function cancelBooking(id) {
            bookingIdToCancel = id;
            $('#cancelBookingModal').modal('show');
        }

        function confirmCancelBooking() {
            if (bookingIdToCancel) {
                const reason = $('#cancellationReason').val();
                
                $.ajax({
                    url: '@Url.Action("Cancel", "Bookings")',
                    type: 'POST',
                    data: {
                        id: bookingIdToCancel,
                        cancellationReason: reason
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        $('#cancelBookingModal').modal('hide');
                        if (response.success) {
                            alert('Booking cancelled successfully!');
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        $('#cancelBookingModal').modal('hide');
                        alert('An error occurred while cancelling the booking. Please try again.');
                    }
                });
            }
        }
    </script>
}
