@{
    ViewData["Title"] = "Pet Owner Dashboard";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1">Welcome back, @User.Identity.Name!</h2>
                            <p class="mb-0">Manage your pets and bookings from your dashboard</p>
                        </div>
                        <div class="text-end">
                            <i class="fas fa-paw fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4 g-3">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-primary mb-2">
                        <i class="fas fa-dog fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-primary">3</h3>
                    <p class="text-muted mb-0">My Pets</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-success mb-2">
                        <i class="fas fa-calendar-check fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-success">2</h3>
                    <p class="text-muted mb-0">Upcoming Bookings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-warning mb-2">
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-warning">1</h3>
                    <p class="text-muted mb-0">Pending Requests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-info mb-2">
                        <i class="fas fa-star fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-info">4.8</h3>
                    <p class="text-muted mb-0">Avg Rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4">
        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt text-primary me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/PetOwner/BookService" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Book New Service
                        </a>
                        <a href="/PetOwner/MyPets" class="btn btn-outline-secondary">
                            <i class="fas fa-paw me-2"></i>Manage My Pets
                        </a>
                        <a href="/Services" class="btn btn-outline-info">
                            <i class="fas fa-search me-2"></i>Browse Services
                        </a>
                        <a href="/PetOwner/Profile" class="btn btn-outline-success">
                            <i class="fas fa-user me-2"></i>Update Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-calendar text-primary me-2"></i>Recent Bookings
                        </h5>
                        <a href="/PetOwner/MyBookings" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Service</th>
                                    <th>Pet</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-cut text-primary me-2"></i>
                                            <span>Dog Grooming</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center">
                                                <i class="fas fa-dog text-muted"></i>
                                            </div>
                                            <span>Max</span>
                                        </div>
                                    </td>
                                    <td>Jan 25, 2025</td>
                                    <td><span class="badge bg-success">Confirmed</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary">View</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-walking text-success me-2"></i>
                                            <span>Dog Walking</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center">
                                                <i class="fas fa-cat text-muted"></i>
                                            </div>
                                            <span>Luna</span>
                                        </div>
                                    </td>
                                    <td>Jan 28, 2025</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary">View</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-stethoscope text-danger me-2"></i>
                                            <span>Vet Visit</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center">
                                                <i class="fas fa-dog text-muted"></i>
                                            </div>
                                            <span>Buddy</span>
                                        </div>
                                    </td>
                                    <td>Feb 02, 2025</td>
                                    <td><span class="badge bg-info">Scheduled</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary">View</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row -->
    <div class="row mt-4 g-4">
        <!-- My Pets -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-heart text-danger me-2"></i>My Pets
                        </h5>
                        <a href="/PetOwner/MyPets" class="btn btn-sm btn-outline-primary">Manage</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card bg-light border-0">
                                <div class="card-body text-center py-3">
                                    <div class="mb-2">
                                        <i class="fas fa-dog fa-2x text-primary"></i>
                                    </div>
                                    <h6 class="mb-1">Max</h6>
                                    <small class="text-muted">Golden Retriever</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0">
                                <div class="card-body text-center py-3">
                                    <div class="mb-2">
                                        <i class="fas fa-cat fa-2x text-warning"></i>
                                    </div>
                                    <h6 class="mb-1">Luna</h6>
                                    <small class="text-muted">Persian Cat</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Favorite Services -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-star text-warning me-2"></i>Favorite Services
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-cut text-primary me-3"></i>
                                    <div>
                                        <h6 class="mb-0">Paws & Claws Grooming</h6>
                                        <small class="text-muted">Professional grooming</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="text-warning">
                                        <i class="fas fa-star"></i> 4.9
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-walking text-success me-3"></i>
                                    <div>
                                        <h6 class="mb-0">Happy Tails Walking</h6>
                                        <small class="text-muted">Daily dog walking</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="text-warning">
                                        <i class="fas fa-star"></i> 4.8
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }

    .card {
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        color: #6c757d;
    }
</style>