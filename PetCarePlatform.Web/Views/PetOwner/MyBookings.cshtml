@model IEnumerable<PetCarePlatform.Core.Models.Booking>
@using PetCarePlatform.Core.Models
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <!-- Error/Success Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-calendar text-primary me-2"></i>My Bookings
                    </h2>
                    <p class="text-muted mb-0">Track your service appointments and history</p>
                    <!-- Debug Info -->
                    <small class="text-muted">
                        Debug: Requested: @Model.Count(b => b.Status == BookingStatus.Requested) | 
                        Pending: @Model.Count(b => b.Status == BookingStatus.Pending) | 
                        Confirmed: @Model.Count(b => b.Status == BookingStatus.Confirmed) |
                        Completed: @Model.Count(b => b.Status == BookingStatus.Completed) |
                        Cancelled: @Model.Count(b => b.Status == BookingStatus.Cancelled)
                    </small>
                </div>
                <a href="@Url.Action("BookService", "PetOwner")" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Book New Service
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- No Bookings Found -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                        <h5>No bookings found</h5>
                        <p class="text-muted">You haven't made any bookings yet. Start by booking a service for your pets!</p>
                        <a href="@Url.Action("BookService", "PetOwner")" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Book Your First Service
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Filter Tabs -->
        <div class="row mb-4">
            <div class="col-12">
                @{
                    var upcomingBookings = Model.Where(b => b.StartTime > DateTime.Now && b.Status != BookingStatus.Cancelled).ToList();
                    var completedBookings = Model.Where(b => b.Status == BookingStatus.Completed).ToList();
                    var cancelledBookings = Model.Where(b => b.Status == BookingStatus.Cancelled).ToList();
                }
                <ul class="nav nav-pills nav-fill" id="bookingTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="upcoming-tab" data-bs-toggle="pill" data-bs-target="#upcoming" type="button" role="tab">
                            <i class="fas fa-clock me-2"></i>Upcoming (@upcomingBookings.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="completed-tab" data-bs-toggle="pill" data-bs-target="#completed" type="button" role="tab">
                            <i class="fas fa-check-circle me-2"></i>Completed (@completedBookings.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="cancelled-tab" data-bs-toggle="pill" data-bs-target="#cancelled" type="button" role="tab">
                            <i class="fas fa-times-circle me-2"></i>Cancelled (@cancelledBookings.Count)
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Tab Content -->
        <div class="tab-content" id="bookingTabContent">
            <!-- Upcoming Bookings -->
            <div class="tab-pane fade show active" id="upcoming" role="tabpanel">
                <div class="row g-4">
                    @if (!upcomingBookings.Any())
                    {
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body text-center py-4">
                                    <i class="fas fa-calendar-plus fa-2x text-muted mb-3"></i>
                                    <h6>No upcoming bookings</h6>
                                    <p class="text-muted">You don't have any upcoming appointments.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var booking in upcomingBookings)
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-2 text-center">
                                                <div class="date-block">
                                                    <div class="month">@booking.StartTime.ToString("MMM").ToUpper()</div>
                                                    <div class="day">@booking.StartTime.Day</div>
                                                    <div class="time">@booking.StartTime.ToString("h:mm tt")</div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-@GetServiceIcon(booking.Service?.Type) text-primary fa-lg me-3"></i>
                                                    <div>
                                                        <h5 class="mb-1">@booking.Service?.Title</h5>
                                                        <p class="text-muted mb-0">@booking.Service?.Provider?.BusinessName</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-@GetPetIcon(booking.Pet?.Type) text-warning me-2"></i>
                                                    <span class="me-3">@booking.Pet?.Name (@booking.Pet?.Breed)</span>
                                                    @if (!string.IsNullOrEmpty(booking.Service?.Location))
                                                    {
                                                        <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                                        <span>@booking.Service.Location</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-2 text-center">
                                                <h4 class="text-success mb-0">$@booking.TotalPrice.ToString("F2")</h4>
                                                <span class="badge bg-@GetStatusBadgeColor(booking.Status)">@booking.Status</span>
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li><a class="dropdown-item" href="#" onclick="viewBookingDetails(@booking.Id)"><i class="fas fa-eye me-2"></i>View Details</a></li>
                                                        @if (booking.Status == BookingStatus.Requested || booking.Status == BookingStatus.Confirmed || booking.Status == BookingStatus.Pending)
                                                        {
                                                            <li><a class="dropdown-item" href="#" onclick="editBooking(@booking.Id)"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                            <li><a class="dropdown-item text-danger" href="#" onclick="cancelBooking(@booking.Id)"><i class="fas fa-times me-2"></i>Cancel</a></li>
                                                        }
                                                        @if (booking.Status == BookingStatus.Confirmed || booking.Status == BookingStatus.Pending)
                                                        {
                                                            <li><a class="dropdown-item" href="#" onclick="rescheduleBooking(@booking.Id)"><i class="fas fa-calendar me-2"></i>Reschedule</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Completed Bookings -->
            <div class="tab-pane fade" id="completed" role="tabpanel">
                <div class="row g-4">
                    @if (!completedBookings.Any())
                    {
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body text-center py-4">
                                    <i class="fas fa-check-circle fa-2x text-muted mb-3"></i>
                                    <h6>No completed bookings</h6>
                                    <p class="text-muted">You haven't completed any services yet.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var booking in completedBookings)
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-2 text-center">
                                                <div class="date-block">
                                                    <div class="month">@booking.StartTime.ToString("MMM").ToUpper()</div>
                                                    <div class="day">@booking.StartTime.Day</div>
                                                    <div class="time">@booking.StartTime.ToString("h:mm tt")</div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-@GetServiceIcon(booking.Service?.Type) text-success fa-lg me-3"></i>
                                                    <div>
                                                        <h5 class="mb-1">@booking.Service?.Title</h5>
                                                        <p class="text-muted mb-0">@booking.Service?.Provider?.BusinessName</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-@GetPetIcon(booking.Pet?.Type) text-warning me-2"></i>
                                                    <span class="me-3">@booking.Pet?.Name (@booking.Pet?.Breed)</span>
                                                    @if (!string.IsNullOrEmpty(booking.Service?.Location))
                                                    {
                                                        <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                                        <span>@booking.Service.Location</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-2 text-center">
                                                <h4 class="text-success mb-0">$@booking.TotalPrice.ToString("F2")</h4>
                                                <span class="badge bg-success">Completed</span>
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li><a class="dropdown-item" href="#" onclick="viewBookingDetails(@booking.Id)"><i class="fas fa-eye me-2"></i>View Details</a></li>
                                                        <li><a class="dropdown-item" href="#" onclick="leaveReview(@booking.Id)"><i class="fas fa-star me-2"></i>Leave Review</a></li>
                                                        <li><a class="dropdown-item" href="#" onclick="rebookService(@booking.ServiceId)"><i class="fas fa-redo me-2"></i>Book Again</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Cancelled Bookings -->
            <div class="tab-pane fade" id="cancelled" role="tabpanel">
                <div class="row g-4">
                    @if (!cancelledBookings.Any())
                    {
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body text-center py-4">
                                    <i class="fas fa-times-circle fa-2x text-muted mb-3"></i>
                                    <h6>No cancelled bookings</h6>
                                    <p class="text-muted">You haven't cancelled any bookings.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var booking in cancelledBookings)
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-2 text-center">
                                                <div class="date-block">
                                                    <div class="month">@booking.StartTime.ToString("MMM").ToUpper()</div>
                                                    <div class="day">@booking.StartTime.Day</div>
                                                    <div class="time">@booking.StartTime.ToString("h:mm tt")</div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-@GetServiceIcon(booking.Service?.Type) text-danger fa-lg me-3"></i>
                                                    <div>
                                                        <h5 class="mb-1">@booking.Service?.Title</h5>
                                                        <p class="text-muted mb-0">@booking.Service?.Provider?.BusinessName</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-@GetPetIcon(booking.Pet?.Type) text-warning me-2"></i>
                                                    <span class="me-3">@booking.Pet?.Name (@booking.Pet?.Breed)</span>
                                                    @if (!string.IsNullOrEmpty(booking.Service?.Location))
                                                    {
                                                        <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                                        <span>@booking.Service.Location</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-2 text-center">
                                                <h4 class="text-danger mb-0">$@booking.TotalPrice.ToString("F2")</h4>
                                                <span class="badge bg-danger">Cancelled</span>
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li><a class="dropdown-item" href="#" onclick="viewBookingDetails(@booking.Id)"><i class="fas fa-eye me-2"></i>View Details</a></li>
                                                        <li><a class="dropdown-item" href="#" onclick="rebookService(@booking.ServiceId)"><i class="fas fa-redo me-2"></i>Book Again</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Details will be loaded here -->
        </div>
    </div>
</div>

@functions {
    private string GetServiceIcon(PetCarePlatform.Core.Models.ServiceType? serviceType)
    {
        return serviceType switch
        {
            PetCarePlatform.Core.Models.ServiceType.DogWalking => "walking",
            PetCarePlatform.Core.Models.ServiceType.PetSitting => "home",
            PetCarePlatform.Core.Models.ServiceType.Grooming => "cut",
            PetCarePlatform.Core.Models.ServiceType.Training => "graduation-cap",
            PetCarePlatform.Core.Models.ServiceType.Veterinary => "stethoscope",
            PetCarePlatform.Core.Models.ServiceType.Boarding => "hotel",
            _ => "paw"
        };
    }

    private string GetPetIcon(PetCarePlatform.Core.Models.PetType? petType)
    {
        return petType switch
        {
            PetCarePlatform.Core.Models.PetType.Dog => "dog",
            PetCarePlatform.Core.Models.PetType.Cat => "cat",
            PetCarePlatform.Core.Models.PetType.Bird => "dove",
            PetCarePlatform.Core.Models.PetType.Fish => "fish",
            PetCarePlatform.Core.Models.PetType.Rabbit => "rabbit",
            PetCarePlatform.Core.Models.PetType.Hamster => "mouse",
            _ => "paw"
        };
    }

    private string GetStatusBadgeColor(PetCarePlatform.Core.Models.BookingStatus status)
    {
        return status switch
        {
            PetCarePlatform.Core.Models.BookingStatus.Pending => "warning",
            PetCarePlatform.Core.Models.BookingStatus.Confirmed => "success",
            PetCarePlatform.Core.Models.BookingStatus.InProgress => "info",
            PetCarePlatform.Core.Models.BookingStatus.Completed => "success",
            PetCarePlatform.Core.Models.BookingStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        function viewBookingDetails(bookingId) {
            $.get('/PetOwner/BookingDetails/' + bookingId, function(html) {
                $('#detailsModal .modal-content').html(html);
                var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                modal.show();
            });
        }

        function rescheduleBooking(bookingId) {
            // Implement reschedule functionality
            alert('Reschedule booking for ID: ' + bookingId);
        }

        function cancelBooking(bookingId) {
            if (confirm('Are you sure you want to cancel this booking? This action cannot be undone.')) {
                $.ajax({
                    url: '/PetOwner/CancelBooking/' + bookingId,
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Show success message
                            showAlert('success', response.message);
                            // Reload the page after a short delay
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            showAlert('danger', response.message);
                        }
                    },
                    error: function() {
                        showAlert('danger', 'An error occurred while cancelling the booking. Please try again.');
                    }
                });
            }
        }

        function editBooking(bookingId) {
            // Redirect to edit booking page
            window.location.href = '/PetOwner/EditBooking/' + bookingId;
        }

        function showAlert(type, message) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            
            // Remove any existing alerts
            $('.alert').remove();
            
            // Add new alert at the top
            $('.container-fluid').prepend(alertHtml);
            
            // Auto-dismiss after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut();
            }, 5000);
        }

        function leaveReview(bookingId) {
            // Implement review functionality
            alert('Leave review for booking ID: ' + bookingId);
        }

        function rebookService(serviceId) {
            // Redirect to book service page
            window.location.href = '@Url.Action("BookService", "PetOwner")?serviceId=' + serviceId;
        }
    </script>
}