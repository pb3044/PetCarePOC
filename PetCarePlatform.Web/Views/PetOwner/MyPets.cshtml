@model List<PetCarePlatform.Core.Models.Pet>
@{
    ViewData["Title"] = "My Pets";
    Layout = "~/Views/Shared/_PetOwnerLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Error/Success Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-heart text-danger me-2"></i>My Pets
                    </h2>
                    <p class="text-muted mb-0">Manage your beloved companions</p>
                </div>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPetModal">
                    <i class="fas fa-plus me-2"></i>Add New Pet
                </button>
            </div>
        </div>
    </div>

    <!-- Pet Cards -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var pet in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="position-relative mb-3">
                                <div class="pet-avatar mx-auto mb-3">
                                    <i class="fas fa-dog fa-4x text-primary"></i>
                                </div>
                                <span class="badge bg-success position-absolute top-0 end-0">Active</span>
                            </div>

                            <h5 class="card-title mb-1">@pet.Name</h5>
                            <p class="text-muted mb-3">@pet.Breed</p>

                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-primary mb-0">@pet.Age</h6>
                                        <small class="text-muted">Years</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-success mb-0">@pet.Size</h6>
                                        <small class="text-muted">Size</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <h6 class="text-warning mb-0">@pet.Gender</h6>
                                    <small class="text-muted">Gender</small>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a class="btn btn-outline-primary btn-sm" href="/PetOwner/PetDetails/@pet.Id">
                                    <i class="fas fa-eye me-2"></i>View Details
                                </a>
                                <div class="btn-group" role="group">
                                    <a class="btn btn-outline-secondary btn-sm" href="/PetOwner/EditPet/@pet.Id">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    @* <button class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-history me-1"></i>History
                                    </button> *@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">You have not added any pets yet.</div>
            </div>
        }

        <!-- Add Pet Card -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-2 border-dashed border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                    <div class="mb-3">
                        <i class="fas fa-plus-circle fa-4x text-primary opacity-50"></i>
                    </div>
                    <h5 class="text-primary mb-2">Add New Pet</h5>
                    <p class="text-muted mb-3">Register a new furry friend</p>
                    <a class="btn btn-primary" href="/PetOwner/AddPet">
                        <i class="fas fa-plus me-2"></i>Add Pet
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Pet Modal -->
<div class="modal fade" id="addPetModal" tabindex="-1" aria-labelledby="addPetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPetModalLabel">
                    <i class="fas fa-plus-circle text-primary me-2"></i>Add New Pet
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addPetForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="petName" class="form-label">Pet Name *</label>
                            <input type="text" class="form-control" id="petName" required>
                        </div>
                        <div class="col-md-6">
                            <label for="petType" class="form-label">Pet Type *</label>
                            <select class="form-select" id="petType" required>
                                <option value="">Select pet type</option>
                                <option value="dog">Dog</option>
                                <option value="cat">Cat</option>
                                <option value="bird">Bird</option>
                                <option value="rabbit">Rabbit</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="petBreed" class="form-label">Breed</label>
                            <input type="text" class="form-control" id="petBreed" placeholder="e.g., Golden Retriever">
                        </div>
                        <div class="col-md-6">
                            <label for="petGender" class="form-label">Gender *</label>
                            <select class="form-select" id="petGender" required>
                                <option value="">Select gender</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="petAge" class="form-label">Age (Years)</label>
                            <input type="number" class="form-control" id="petAge" min="0" max="30" step="0.1">
                        </div>
                        <div class="col-md-6">
                            <label for="petWeight" class="form-label">Weight (lbs)</label>
                            <input type="number" class="form-control" id="petWeight" min="0" step="0.1">
                        </div>
                        <div class="col-12">
                            <label for="petColor" class="form-label">Color/Markings</label>
                            <input type="text" class="form-control" id="petColor" placeholder="e.g., Golden, Black spots">
                        </div>
                        <div class="col-12">
                            <label for="petMedical" class="form-label">Medical Conditions</label>
                            <textarea class="form-control" id="petMedical" rows="3" placeholder="Any allergies, medications, or health conditions..."></textarea>
                        </div>
                        <div class="col-12">
                            <label for="petNotes" class="form-label">Additional Notes</label>
                            <textarea class="form-control" id="petNotes" rows="2" placeholder="Behavior, preferences, special instructions..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="petVaccinated">
                                <label class="form-check-label" for="petVaccinated">
                                    Up to date on vaccinations
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePet()">
                    <i class="fas fa-save me-2"></i>Save Pet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Pet Details Modal -->
<div class="modal fade" id="petDetailsModal" tabindex="-1" aria-labelledby="petDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="petDetailsModalLabel">
                    <i class="fas fa-info-circle text-primary me-2"></i>Pet Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="petDetailsContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="editCurrentPet()">
                    <i class="fas fa-edit me-2"></i>Edit Pet
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .pet-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #e9ecef;
    }

    .card {
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .border-dashed {
        border-style: dashed !important;
    }

    .btn-group .btn {
        flex: 1;
    }

    .modal-body .row {
        margin-bottom: 1rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .badge {
        font-size: 0.7rem;
    }
</style>

<script>
    let currentPet = null;

    function viewPetDetails(petName) {
        // Sample pet data - in real app, this would come from your backend
        const pets = {
            'max': {
                name: 'Max',
                type: 'Dog',
                breed: 'Golden Retriever',
                age: 3,
                weight: 65,
                gender: 'Male',
                color: 'Golden',
                vaccinated: true,
                medical: 'No known allergies',
                notes: 'Very friendly, loves playing fetch'
            },
            'luna': {
                name: 'Luna',
                type: 'Cat',
                breed: 'Persian',
                age: 2,
                weight: 12,
                gender: 'Female',
                color: 'White with gray markings',
                vaccinated: true,
                medical: 'Sensitive to certain foods',
                notes: 'Prefers quiet environments'
            },
            'buddy': {
                name: 'Buddy',
                type: 'Dog',
                breed: 'Labrador Mix',
                age: 5,
                weight: 55,
                gender: 'Male',
                color: 'Chocolate brown',
                vaccinated: true,
                medical: 'Hip dysplasia (mild)',
                notes: 'Great with children, needs daily exercise'
            }
        };

        const pet = pets[petName];
        currentPet = petName;

        const content = `
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card bg-light border-0">
                        <div class="card-body text-center">
                            <i class="fas fa-${pet.type.toLowerCase()} fa-4x text-primary mb-3"></i>
                            <h4>${pet.name}</h4>
                            <p class="text-muted">${pet.breed}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0">
                        <div class="card-body">
                            <h6 class="text-primary mb-3">Basic Information</h6>
                            <div class="row g-2">
                                <div class="col-6"><strong>Age:</strong> ${pet.age} years</div>
                                <div class="col-6"><strong>Weight:</strong> ${pet.weight} lbs</div>
                                <div class="col-6"><strong>Gender:</strong> ${pet.gender}</div>
                                <div class="col-6"><strong>Color:</strong> ${pet.color}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card border-0">
                        <div class="card-body">
                            <h6 class="text-primary mb-3">Health & Care</h6>
                            <div class="mb-3">
                                <strong>Vaccinations:</strong>
                                <span class="badge bg-${pet.vaccinated ? 'success' : 'warning'} ms-2">
                                    ${pet.vaccinated ? 'Up to date' : 'Needs update'}
                                </span>
                            </div>
                            <div class="mb-3">
                                <strong>Medical Conditions:</strong><br>
                                <span class="text-muted">${pet.medical}</span>
                            </div>
                            <div>
                                <strong>Notes:</strong><br>
                                <span class="text-muted">${pet.notes}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('petDetailsContent').innerHTML = content;
        new bootstrap.Modal(document.getElementById('petDetailsModal')).show();
    }

    function editPet(petName) {
        alert(`Edit functionality for ${petName} would open edit form here`);
    }

    function petHistory(petName) {
        alert(`Service history for ${petName} would be displayed here`);
    }

    function editCurrentPet() {
        if (currentPet) {
            editPet(currentPet);
            bootstrap.Modal.getInstance(document.getElementById('petDetailsModal')).hide();
        }
    }

    function savePet() {
        // Validate form
        const form = document.getElementById('addPetForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        // Get form data
        const petData = {
            name: document.getElementById('petName').value,
            type: document.getElementById('petType').value,
            breed: document.getElementById('petBreed').value,
            gender: document.getElementById('petGender').value,
            age: document.getElementById('petAge').value,
            weight: document.getElementById('petWeight').value,
            color: document.getElementById('petColor').value,
            medical: document.getElementById('petMedical').value,
            notes: document.getElementById('petNotes').value,
            vaccinated: document.getElementById('petVaccinated').checked
        };

        // Here you would send the data to your backend
        console.log('Saving pet:', petData);

        // Show success message and close modal
        alert('Pet added successfully!');
        bootstrap.Modal.getInstance(document.getElementById('addPetModal')).hide();

        // Reset form
        form.reset();

        // In a real app, you would reload the page or add the new pet card dynamically
    }
</script>