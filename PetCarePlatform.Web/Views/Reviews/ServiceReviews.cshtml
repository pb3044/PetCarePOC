@model PetCarePlatform.Web.Models.ServiceReviewsViewModel
@{
    ViewData["Title"] = "Reviews for " + Model.ServiceName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-star text-warning me-2"></i>Reviews for @Model.ServiceName
                    </h2>
                    <p class="text-muted mb-0">@Model.ProviderName</p>
                </div>
                <a href="@Url.Action("Details", "Services", new { id = Model.ServiceId })" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Service
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <!-- Rating Summary -->
            <div class="card">
                <div class="card-body text-center">
                    <div class="rating-summary">
                        <div class="average-rating">
                            <span class="rating-number">@Model.AverageRating.ToString("F1")</span>
                            <div class="stars text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(Model.AverageRating))
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else if (i - 0.5 <= Model.AverageRating)
                                    {
                                        <i class="fas fa-star-half-alt"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                            </div>
                        </div>
                        <p class="text-muted mb-0">Based on @Model.TotalReviews review@(Model.TotalReviews != 1 ? "s" : "")</p>
                    </div>
                </div>
            </div>

            <!-- Rating Breakdown -->
            @if (Model.TotalReviews > 0)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">Rating Breakdown</h6>
                    </div>
                    <div class="card-body">
                        @{
                            var ratingCounts = Model.Reviews.GroupBy(r => r.Rating)
                                .ToDictionary(g => g.Key, g => g.Count());
                        }
                        @for (int rating = 5; rating >= 1; rating--)
                        {
                            var count = ratingCounts.ContainsKey(rating) ? ratingCounts[rating] : 0;
                            var percentage = Model.TotalReviews > 0 ? (count * 100.0 / Model.TotalReviews) : 0;
                            
                            <div class="rating-bar mb-2">
                                <div class="d-flex align-items-center">
                                    <span class="rating-label me-2">@rating <i class="fas fa-star text-warning"></i></span>
                                    <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                        <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                    </div>
                                    <span class="rating-count">@count</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-8">
            <!-- Reviews List -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Customer Reviews</h5>
                </div>
                <div class="card-body">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="review-item border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-1">@(review.Reviewer?.FirstName + " " + review.Reviewer?.LastName)</h6>
                                        <div class="stars text-warning mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                
                                <p class="text-muted mb-2">
                                    <strong>Service:</strong> @review.Service?.Title<br>
                                    @if (review.Booking?.Pet != null)
                                    {
                                        <strong>Pet:</strong> @(review.Booking.Pet.Name + " - " + review.Booking.Pet.Breed)
                                    }
                                </p>
                                
                                <p class="mb-2">@review.Comment</p>
                                
                                @if (!string.IsNullOrEmpty(review.Response))
                                {
                                    <div class="provider-response bg-light p-3 rounded">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-reply text-primary me-2"></i>
                                            <strong>Response from @Model.ProviderName</strong>
                                        </div>
                                        <p class="mb-0">@review.Response</p>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Reviews pagination">
                                <ul class="pagination justify-content-center">
                                    @if (Model.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("ServiceReviews", new { serviceId = Model.ServiceId, page = Model.CurrentPage - 1 })">
                                                <i class="fas fa-chevron-left"></i>
                                            </a>
                                        </li>
                                    }
                                    
                                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("ServiceReviews", new { serviceId = Model.ServiceId, page = i })">@i</a>
                                        </li>
                                    }
                                    
                                    @if (Model.CurrentPage < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("ServiceReviews", new { serviceId = Model.ServiceId, page = Model.CurrentPage + 1 })">
                                                <i class="fas fa-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-star fa-3x text-muted mb-3"></i>
                            <h5>No reviews yet</h5>
                            <p class="text-muted">Be the first to review this service!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-summary .average-rating {
        margin-bottom: 1rem;
    }
    
    .rating-summary .rating-number {
        font-size: 3rem;
        font-weight: bold;
        color: #333;
        display: block;
    }
    
    .rating-summary .stars {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    
    .rating-bar .rating-label {
        min-width: 60px;
        font-size: 0.9rem;
    }
    
    .rating-bar .rating-count {
        min-width: 30px;
        text-align: right;
        font-size: 0.9rem;
    }
    
    .review-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
    
    .provider-response {
        border-left: 3px solid #007bff;
    }
</style>
