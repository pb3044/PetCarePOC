@model PetCarePlatform.Web.Models.ServiceProviderBookingRequestViewModel
@{
    ViewData["Title"] = "Booking Requests";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <!-- Error Messages -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="row align-items-center mb-5">
        <div class="col-md-6 mb-3 mb-md-0">
            <h1 class="fw-800 mb-1" style="letter-spacing: -1px;">Booking Requests</h1>
            <p class="text-muted mb-0">Manage incoming requests and grow your business</p>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                <div class="glass-card px-3 py-2 d-flex align-items-center gap-2">
                    <span class="dot bg-warning"></span>
                    <span class="fw-600 text-dark">@Model.TotalPendingCount Pending</span>
                </div>
                <div class="glass-card px-3 py-2 d-flex align-items-center gap-2">
                    <span class="dot bg-info"></span>
                    <span class="fw-600 text-dark">@Model.TotalRecentCount Recent</span>
                </div>
            </div>
        </div>
    </div>

    <style>
        .fw-800 { font-weight: 800; }
        .fw-600 { font-weight: 600; }
        .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .table-premium {
            border-collapse: separate;
            border-spacing: 0 12px;
        }
        .table-premium tr {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
        }
        .table-premium tr:hover {
            transform: scale(1.01);
            background: white;
        }
        .table-premium td {
            border: none;
            padding: 20px 15px;
            vertical-align: middle;
        }
        .table-premium td:first-child { border-radius: 15px 0 0 15px; }
        .table-premium td:last-child { border-radius: 0 15px 15px 0; }
        .table-premium thead th {
            border: none;
            color: #64748b;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 0 15px 10px;
        }
    </style>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <form method="get" id="filterForm">
                        <div class="row">
                            <div class="col-md-2">
                                <label for="Status" class="form-label">Status</label>
                                <select class="form-select" id="Status" name="Status">
                                    <option value="">All Statuses</option>
                                    <option value="Pending" selected="@(Model.Filters.Status == "Pending")">Pending</option>
                                    <option value="Confirmed" selected="@(Model.Filters.Status == "Confirmed")">Confirmed</option>
                                    <option value="Declined" selected="@(Model.Filters.Status == "Declined")">Declined</option>
                                    <option value="Completed" selected="@(Model.Filters.Status == "Completed")">Completed</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="FromDate" class="form-label">From Date</label>
                                <input type="date" class="form-control" id="FromDate" name="FromDate" value="@Model.Filters.FromDate?.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-2">
                                <label for="ToDate" class="form-label">To Date</label>
                                <input type="date" class="form-control" id="ToDate" name="ToDate" value="@Model.Filters.ToDate?.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-2">
                                <label for="ServiceType" class="form-label">Service Type</label>
                                <select class="form-select" id="ServiceType" name="ServiceType">
                                    <option value="">All Services</option>
                                    <option value="PetSitting" selected="@(Model.Filters.ServiceType == "PetSitting")">Pet Sitting</option>
                                    <option value="DogWalking" selected="@(Model.Filters.ServiceType == "DogWalking")">Dog Walking</option>
                                    <option value="Grooming" selected="@(Model.Filters.ServiceType == "Grooming")">Grooming</option>
                                    <option value="Training" selected="@(Model.Filters.ServiceType == "Training")">Training</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="SearchTerm" class="form-label">Search</label>
                                <input type="text" class="form-control" id="SearchTerm" name="SearchTerm" value="@Model.Filters.SearchTerm" placeholder="Search...">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i> Filter
                                    </button>
                                    <a href="@Url.Action("BookingRequest")" class="btn btn-outline-secondary">
                                        <i class="fas fa-times"></i> Clear
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ShowOnlyAvailable" name="ShowOnlyAvailable" value="true" checked="@(Model.Filters.ShowOnlyAvailable == true)">
                                    <label class="form-check-label" for="ShowOnlyAvailable">
                                        Show only available bookings
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Requests -->
    <h5 class="fw-700 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-clock-history text-warning"></i>
        Pending Requests (@Model.PendingRequests.Count)
    </h5>

    @if (Model.PendingRequests.Any())
    {
        <div class="table-responsive">
            <table class="table table-premium">
                <thead>
                    <tr>
                        <th>Pet Owner</th>
                        <th>Service & Pet</th>
                        <th>Date & Time</th>
                        <th>Price</th>
                        <th>Availability</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.PendingRequests)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-box bg-purple-light text-purple">
                                        <i class="bi bi-person fw-bold"></i>
                                    </div>
                                    <div>
                                        <div class="fw-700">@request.PetOwnerName</div>
                                        <div class="text-muted small">@request.PetOwnerPhone</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-700">@request.ServiceName</div>
                                <div class="text-muted small"><i class="bi bi-suit-heart me-1"></i>@request.PetName</div>
                            </td>
                            <td>
                                <div class="fw-700">@request.StartTime.ToString("MMM dd")</div>
                                <div class="text-muted small">@request.StartTime.ToString("HH:mm") - @request.EndTime.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-700 text-dark">$@request.TotalPrice.ToString("F2")</div>
                            </td>
                            <td>
                                <span class="badge @(request.IsAvailable ? "bg-success" : "bg-danger") rounded-pill px-3">
                                    @(request.IsAvailable ? "Available" : "Conflict")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button type="button" class="btn btn-light btn-sm rounded-3 px-3 fw-600" data-bs-toggle="modal" data-bs-target="#requestDetailsModal" data-request-id="@request.Id">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (request.IsAvailable)
                                    {
                                        <button type="button" class="btn btn-success btn-sm rounded-3 px-3 fw-600 accept-booking" data-booking-id="@request.Id">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3 fw-600 reject-booking" data-booking-id="@request.Id">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="glass-card p-5 text-center mb-5">
            <i class="bi bi-inbox fa-3x text-muted mb-3 d-block"></i>
            <h5 class="text-muted">No pending requests</h5>
            <p class="text-muted mb-0">You're all caught up!</p>
        </div>
    }

    <style>
        .avatar-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .bg-purple-light { background: #f3f0ff; }
        .text-purple { color: #7c4dff; }
    </style>

    <!-- Recent Requests -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history text-info me-2"></i>
                        Recent Requests (@Model.RecentRequests.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Pet Owner</th>
                                        <th>Service & Pet</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                        <th>Price</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.RecentRequests)
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@request.PetOwnerName</strong><br>
                                                    <small class="text-muted">
                                                        <i class="fas fa-envelope me-1"></i>@request.PetOwnerEmail
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@request.ServiceName</strong><br>
                                                    <small class="text-muted">
                                                        <i class="fas fa-paw me-1"></i>@request.PetName (@request.PetType)
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@request.StartTime.ToString("MMM dd, yyyy")</strong><br>
                                                    <small class="text-muted">
                                                        @request.StartTime.ToString("HH:mm") - @request.EndTime.ToString("HH:mm")
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-@(request.Status == "Confirmed" ? "success" : request.Status == "Declined" ? "danger" : "secondary")">
                                                    @request.Status
                                                </span>
                                            </td>
                                            <td>
                                                <strong>$@request.TotalPrice.ToString("F2")</strong>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                                        data-bs-toggle="modal" data-bs-target="#requestDetailsModal" 
                                                        data-request-id="@request.Id">
                                                    <i class="fas fa-eye"></i> Details
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No recent requests</h5>
                            <p class="text-muted">Recent booking activity will appear here</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Request Details Modal -->
<div class="modal fade" id="requestDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Booking Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="requestDetailsContent">
                <!-- Content will be loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Reject Booking Modal -->
<div class="modal fade" id="rejectBookingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Decline Booking Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="rejectForm">
                    <input type="hidden" id="rejectBookingId" name="bookingId">
                    <div class="mb-3">
                        <label for="rejectReason" class="form-label">Reason for Declining</label>
                        <textarea class="form-control" id="rejectReason" name="reason" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmReject">Decline Booking</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Accept booking
            $('.accept-booking').on('click', function() {
                const bookingId = $(this).data('booking-id');
                if (confirm('Are you sure you want to accept this booking?')) {
                    $.post('@Url.Action("AcceptBooking")', { bookingId: bookingId })
                        .done(function(response) {
                            if (response.success) {
                                showAlert('success', response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showAlert('danger', response.message);
                            }
                        })
                        .fail(function() {
                            showAlert('danger', 'An error occurred while accepting the booking');
                        });
                }
            });

            // Reject booking
            $('.reject-booking').on('click', function() {
                const bookingId = $(this).data('booking-id');
                $('#rejectBookingId').val(bookingId);
                $('#rejectBookingModal').modal('show');
            });

            // Confirm reject
            $('#confirmReject').on('click', function() {
                const bookingId = $('#rejectBookingId').val();
                const reason = $('#rejectReason').val();
                
                if (!reason.trim()) {
                    showAlert('danger', 'Please provide a reason for declining');
                    return;
                }

                $.post('@Url.Action("RejectBooking")', { bookingId: bookingId, reason: reason })
                    .done(function(response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            $('#rejectBookingModal').modal('hide');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showAlert('danger', response.message);
                        }
                    })
                    .fail(function() {
                        showAlert('danger', 'An error occurred while declining the booking');
                    });
            });

            // Show alert function
            function showAlert(type, message) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                $('.container-fluid').prepend(alertHtml);
            }

            // Load booking details when Details button is clicked
            $('#requestDetailsModal').on('show.bs.modal', function (event) {
                const button = $(event.relatedTarget);
                const requestId = button.data('request-id');
                const modal = $(this);
                
                // Clear previous content
                modal.find('#requestDetailsContent').html('<div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                
                // Load booking details
                $.get('@Url.Action("BookingDetails", "ServiceProvider")/' + requestId)
                    .done(function(html) {
                        modal.find('#requestDetailsContent').html(html);
                    })
                    .fail(function() {
                        modal.find('#requestDetailsContent').html('<div class="alert alert-danger">Failed to load booking details. Please try again.</div>');
                    });
            });
        });
    </script>
}