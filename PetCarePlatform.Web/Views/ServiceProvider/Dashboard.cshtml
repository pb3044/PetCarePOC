@model PetCarePlatform.Web.Models.ServiceProviderDashboardViewModel
@{
    ViewData["Title"] = "Service Provider Dashboard";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <!-- Error Messages -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h1 class="fw-800 mb-1" style="letter-spacing: -1px;">Pro Dashboard</h1>
            <p class="text-muted mb-0">Analytics and overview for <span class="fw-600 text-dark">@Model.ProviderInfo.BusinessName</span></p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="glass-card d-inline-flex align-items-center px-3 py-2 gap-2">
                <span class="dot @(Model.ProviderInfo.IsAvailableToday ? "bg-success" : "bg-danger")"></span>
                <span class="fw-600 text-dark">@Model.ProviderInfo.CurrentAvailabilityStatus</span>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 h-100 p-3 stats-hover">
                <div class="d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box bg-purple-light text-purple">
                            <i class="bi bi-calendar-check fs-5"></i>
                        </div>
                        <span class="badge text-success bg-success-light rounded-pill">+12%</span>
                    </div>
                    <h3 class="fw-800 mb-1">@Model.TotalBookings</h3>
                    <p class="text-muted small fw-600 mb-0">Total Bookings</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 h-100 p-3 stats-hover">
                <div class="d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box bg-orange-light text-orange">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                        @if (Model.PendingRequests > 0) {
                            <span class="badge text-warning bg-warning-light rounded-pill">@Model.PendingRequests Action</span>
                        }
                    </div>
                    <h3 class="fw-800 mb-1">@Model.PendingRequests</h3>
                    <p class="text-muted small fw-600 mb-0">Pending</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 h-100 p-3 stats-hover">
                <div class="d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box bg-blue-light text-blue">
                            <i class="bi bi-grid fs-5"></i>
                        </div>
                        <span class="badge text-info bg-info-light rounded-pill">Active</span>
                    </div>
                    <h3 class="fw-800 mb-1">@Model.ActiveServices</h3>
                    <p class="text-muted small fw-600 mb-0">My Services</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 h-100 p-3 stats-hover">
                <div class="d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box bg-green-light text-green">
                            <i class="bi bi-wallet2 fs-5"></i>
                        </div>
                        <span class="badge text-success bg-success-light rounded-pill">+8%</span>
                    </div>
                    <h3 class="fw-800 mb-1">$@Model.MonthlyEarnings.ToString("N0")</h3>
                    <p class="text-muted small fw-600 mb-0">Earnings</p>
                </div>
            </div>
        </div>
    </div>

    <style>
        .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .bg-purple-light { background: #f3f0ff; }
        .text-purple { color: #7c4dff; }
        .bg-orange-light { background: #fff8f1; }
        .text-orange { color: #ff9100; }
        .bg-blue-light { background: #eef2ff; }
        .text-blue { color: #3d5afe; }
        .bg-green-light { background: #f0fdf4; }
        .text-green { color: #22c55e; }
        .bg-success-light { background: rgba(34, 197, 94, 0.1); }
        .bg-warning-light { background: rgba(245, 158, 11, 0.1); }
        .bg-info-light { background: rgba(59, 130, 246, 0.1); }
        .stats-hover { transition: transform 0.3s ease; }
        .stats-hover:hover { transform: translateY(-5px); }
        .fw-800 { font-weight: 800; }
        .fw-700 { font-weight: 700; }
        .fw-600 { font-weight: 600; }
        .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    </style>

    <!-- Recent Activity & Upcoming Appointments -->
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Recent Booking Requests</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Pet Owner</th>
                                        <th>Service</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Availability</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.RecentRequests)
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@request.PetOwnerName</strong><br>
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-envelope me-1"></i>
                                                        @if (!string.IsNullOrWhiteSpace(request.PetOwnerEmail))
                                                        {
                                                            <span>@request.PetOwnerEmail</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">N/A</span>
                                                        }
                                                    </small>
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-phone me-1"></i>
                                                        @if (!string.IsNullOrWhiteSpace(request.PetOwnerPhone))
                                                        {
                                                            <span>@request.PetOwnerPhone</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">N/A</span>
                                                        }
                                                    </small>
                                                </div>
                                            </td>
                                            <td>@request.ServiceName</td>
                                            <td>@request.RequestDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge badge-@(request.Status == "Pending" ? "warning" : request.Status == "Confirmed" ? "success" : "danger")">
                                                    @request.Status
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(request.IsAvailable ? "bg-success" : "bg-danger")" 
                                                      title="@request.AvailabilityMessage">
                                                    @(request.IsAvailable ? "Available" : "Unavailable")
                                                </span>
                                            </td>
                                            <td>
                                                @if (request.Status == "Pending")
                                                {
                                                    <a href="@Url.Action("BookingRequest", "ServiceProvider")" class="btn btn-sm btn-outline-primary">
                                                        View Details
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No recent booking requests.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Today's Schedule</h5>
                </div>
                <div class="card-body">
                    @if (Model.TodaySchedule.Any())
                    {
                        @foreach (var appointment in Model.TodaySchedule)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded">
                                <div>
                                    <strong>@appointment.ServiceName</strong><br>
                                    <small class="text-muted">@appointment.PetOwnerName - @appointment.PetName</small><br>
                                    <small class="text-info">@appointment.Time</small>
                                    @if (!string.IsNullOrEmpty(appointment.SpecialInstructions))
                                    {
                                        <br><small class="text-warning">@appointment.SpecialInstructions</small>
                                    }
                                </div>
                                <div class="text-end">
                                    <span class="badge badge-primary">@appointment.Status</span><br>
                                    <small class="text-success">$@appointment.TotalPrice.ToString("F2")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No appointments scheduled for today.</p>
                    }
                </div>
            </div>

            <!-- Provider Info Card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Provider Info</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">Business Name</small><br>
                        <strong>@Model.ProviderInfo.BusinessName</strong>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Rating</small><br>
                        <div class="d-flex align-items-center">
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star@(i <= Model.ProviderInfo.AverageRating ? "" : "-o")"></i>
                                }
                            </span>
                            <span class="ms-2">
                                @(Model.ProviderInfo.AverageRating.HasValue
                                                                ? Model.ProviderInfo.AverageRating.Value.ToString("F1")
                                                                : "-")
                            </span>
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Email</small><br>
                        <strong>@Model.ProviderInfo.Email</strong>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("MyServices", "ServiceProvider")" class="btn btn-outline-primary">
                            <i class="fas fa-cog"></i> Manage Services
                        </a>
                        <a href="@Url.Action("BookingRequest", "ServiceProvider")" class="btn btn-outline-success">
                            <i class="fas fa-envelope"></i> View All Requests
                        </a>
                        <a href="@Url.Action("Schedule", "ServiceProvider")" class="btn btn-outline-info">
                            <i class="fas fa-calendar"></i> View Schedule
                        </a>
                        <a href="@Url.Action("Profile", "ServiceProvider")" class="btn btn-outline-warning">
                            <i class="fas fa-user-edit"></i> Update Profile
                        </a>
                        <a href="@Url.Action("Analytics", "ServiceProvider")" class="btn btn-outline-info">
                            <i class="fas fa-chart-line"></i> View Analytics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <style>
        .stats-trend { display: none; }
    </style>

@section Scripts {
    <script>
        // Auto-refresh dashboard every 5 minutes
        setTimeout(function() {
            location.reload();
        }, 300000);
        
        // Add smooth animations
        $(document).ready(function() {
            $('.stats-card').each(function(index) {
                $(this).css('animation-delay', (index * 0.1) + 's');
                $(this).addClass('animate__animated animate__fadeInUp');
            });
        });
    </script>
}