@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "My Services";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>My Services</h1>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                    <i class="fas fa-plus"></i> Add New Service
                </button>
            </div>
        </div>
    </div>

    <!-- Services Grid -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var service in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title">@service.Title</h5>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#" onclick="editService(@service.Id)"><i class="fas fa-edit"></i> Edit</a></li>
                                        <li>
                                            <a class="dropdown-item" href="#" onclick="toggleService(@service.Id, @service.IsActive.ToString().ToLower())">
                                                <i class="fas fa-@(service.IsActive ? "pause" : "play")"></i>
                                                @(service.IsActive ? "Deactivate" : "Activate")
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="deleteService(@service.Id)"><i class="fas fa-trash"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </div>

                            <p class="card-text">@service.Description</p>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Price</small>
                                    <div class="fw-bold text-success">$@service.Price</div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Duration</small>
                                    <div>@service.Duration mins</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge badge-@(service.IsActive ? "success" : "secondary")">
                                    @(service.IsActive ? "Active" : "Inactive")
                                </span>
                                <small class="text-muted">@service.BookingCount bookings</small>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between">
                                <a href="@Url.Action("ViewBookings", "MyServices", new { serviceId = service.Id })" class="btn btn-sm btn-outline-primary">
                                    View Bookings
                                </a>
                                <a href="@Url.Action("ServiceStats", "MyServices", new { serviceId = service.Id })" class="btn btn-sm btn-outline-info">
                                    Statistics
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-paw fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No Services Added Yet</h4>
                    <p class="text-muted">Start by adding your first pet service to attract customers.</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                        <i class="fas fa-plus"></i> Add Your First Service
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addServiceModalLabel">Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addServiceForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="serviceTitle" class="form-label">Service Title</label>
                            <select class="form-select" id="serviceTitle" name="ServiceId" required>
                                <option value="">Select a service...</option>
                                <option value="1">Dog Walking</option>
                                <option value="2">Pet Sitting</option>
                                <option value="3">Mobile Pet Grooming</option>
                                <option value="4">Nail Trimming</option>
                                <option value="5">Veterinary Consultation</option>
                                <option value="6">Pet Vaccination</option>
                                <option value="7">Emergency Pet Care</option>
                                <option value="8">Pet Training & Obedience</option>
                                <option value="9">Puppy Socialization Classes</option>
                                <option value="10">Pet Taxi Service</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="servicePrice" class="form-label">Price ($)</label>
                            <input type="number" class="form-control" id="servicePrice" name="Price" step="0.01" min="0" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="serviceDuration" class="form-label">Duration (minutes)</label>
                            <input type="number" class="form-control" id="serviceDuration" name="Duration" min="15" step="15" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="serviceArea" class="form-label">Service Area</label>
                            <input type="text" class="form-control" id="serviceArea" name="ServiceArea" placeholder="e.g., Downtown, Oak Bay">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="serviceDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="serviceDescription" name="Description" rows="3" placeholder="Describe your service, experience, and what makes you special..."></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="availableDays" class="form-label">Available Days</label>
                            <div class="form-check-container">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="monday" name="AvailableDays" value="Monday">
                                    <label class="form-check-label" for="monday">Mon</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="tuesday" name="AvailableDays" value="Tuesday">
                                    <label class="form-check-label" for="tuesday">Tue</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="wednesday" name="AvailableDays" value="Wednesday">
                                    <label class="form-check-label" for="wednesday">Wed</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="thursday" name="AvailableDays" value="Thursday">
                                    <label class="form-check-label" for="thursday">Thu</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="friday" name="AvailableDays" value="Friday">
                                    <label class="form-check-label" for="friday">Fri</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="saturday" name="AvailableDays" value="Saturday">
                                    <label class="form-check-label" for="saturday">Sat</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="sunday" name="AvailableDays" value="Sunday">
                                    <label class="form-check-label" for="sunday">Sun</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="availableTime" class="form-label">Available Hours</label>
                            <div class="row">
                                <div class="col-6">
                                    <input type="time" class="form-control" id="availableFromTime" name="AvailableFromTime">
                                    <small class="form-text text-muted">From</small>
                                </div>
                                <div class="col-6">
                                    <input type="time" class="form-control" id="availableToTime" name="AvailableToTime">
                                    <small class="form-text text-muted">To</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editService(serviceId) {
            // Implement edit functionality
            window.location.href = '@Url.Action("Edit", "MyServices")/' + serviceId;
        }

        function toggleService(serviceId, isActive) {
            if (confirm('Are you sure you want to ' + (isActive ? 'deactivate' : 'activate') + ' this service?')) {
                $.ajax({
                    url: '@Url.Action("ToggleStatus", "MyServices")',
                    type: 'POST',
                    data: { id: serviceId },
                    success: function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the service.');
                    }
                });
            }
        }

        function deleteService(serviceId) {
            if (confirm('Are you sure you want to delete this service? This action cannot be undone.')) {
                $.ajax({
                    url: '@Url.Action("Delete", "MyServices")',
                    type: 'POST',
                    data: { id: serviceId },
                    success: function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while deleting the service.');
                    }
                });
            }
        }

        // Handle form submission
        $('#addServiceForm').on('submit', function(e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("Create", "MyServices")',
                type: 'POST',
                data: $(this).serialize(),
                success: function(result) {
                    if (result.success) {
                        $('#addServiceModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                },
                error: function() {
                    alert('An error occurred while adding the service.');
                }
            });
        });
    </script>
}