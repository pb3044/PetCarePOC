@model PetCarePlatform.Web.Models.ServiceProviderMyServicesViewModel
@{
    ViewData["Title"] = "My Services";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <!-- Error Messages -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1">My Services</h1>
                    <p class="text-muted mb-0">Manage your pet care services</p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success fs-6">@Model.ActiveServices Active</span>
                    <span class="badge bg-secondary fs-6">@Model.InactiveServices Inactive</span>
                    <span class="badge bg-info fs-6">@Model.TotalServices Total</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Add New Service Button -->
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                <i class="fas fa-plus me-2"></i>Add New Service
            </button>
        </div>
    </div>

    <!-- Services Grid -->
    <div class="row">
        @if (Model.Services.Any())
        {
            @foreach (var service in Model.Services)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 @(service.IsActive ? "border-success" : "border-secondary")">
                        <!-- Service Image -->
                        <div class="position-relative">
                            <img src="@service.PrimaryPhotoUrl" class="card-img-top" alt="@service.Title" style="height: 200px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge @(service.IsActive ? "bg-success" : "bg-secondary")">
                                    @(service.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Service Title and Type -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@service.Title</h5>
                                <span class="badge bg-primary">@service.Type</span>
                            </div>

                            <!-- Description -->
                            <p class="card-text text-muted small">
                                @(service.Description.Length > 100 ? service.Description.Substring(0, 100) + "..." : service.Description)
                            </p>

                            <!-- Price and Location -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 text-success mb-0">$@service.BasePrice.ToString("F2")</span>
                                    <small class="text-muted">@service.PriceUnit</small>
                                </div>
                                <small class="text-muted">
                                    <i class="fas fa-map-marker-alt me-1"></i>@service.Location
                                </small>
                            </div>

                            <!-- Stats -->
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="border-end">
                                        <div class="h6 mb-0">@service.TotalBookings</div>
                                        <small class="text-muted">Bookings</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border-end">
                                        <div class="h6 mb-0">@service.AverageRating.ToString("F1")</div>
                                        <small class="text-muted">Rating</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div>
                                        <div class="h6 mb-0">@service.TotalReviews</div>
                                        <small class="text-muted">Reviews</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Pet Types and Sizes -->
                            <div class="mb-3">
                                <small class="text-muted">
                                    <strong>Pet Types:</strong> @service.AcceptedPetTypes<br>
                                    <strong>Pet Sizes:</strong> @service.AcceptedPetSizes<br>
                                    <strong>Max Pets:</strong> @service.MaxPetsPerBooking
                                </small>
                            </div>

                            <!-- Actions -->
                            <div class="d-grid gap-2">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editServiceModal" data-service-id="@service.Id">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-@(service.IsActive ? "warning" : "success") btn-sm toggle-status" data-service-id="@service.Id" data-current-status="@service.IsActive.ToString().ToLower()">
                                        <i class="fas fa-@(service.IsActive ? "pause" : "play")"></i>
                                        @(service.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm delete-service" data-service-id="@service.Id" data-service-title="@service.Title">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer text-muted small">
                            <div class="d-flex justify-content-between">
                                <span>Created: @service.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <span>Updated: @service.UpdatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-paw fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No Services Yet</h4>
                    <p class="text-muted">Start by adding your first pet care service to attract customers.</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                        <i class="fas fa-plus me-2"></i>Add Your First Service
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addServiceModalLabel">Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addServiceForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Title" class="form-label">Service Title *</label>
                                <input type="text" class="form-control" id="Title" name="Title" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Type" class="form-label">Service Type *</label>
                                <select class="form-select" id="Type" name="Type" required>
                                    <option value="">Select Type</option>
                                    <option value="PetSitting">Pet Sitting</option>
                                    <option value="DogWalking">Dog Walking</option>
                                    <option value="Grooming">Grooming</option>
                                    <option value="Training">Training</option>
                                    <option value="Veterinary">Veterinary</option>
                                    <option value="Boarding">Boarding</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label">Description *</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="BasePrice" class="form-label">Base Price *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="BasePrice" name="BasePrice" step="0.01" min="0" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="PriceUnit" class="form-label">Price Unit *</label>
                                <select class="form-select" id="PriceUnit" name="PriceUnit" required>
                                    <option value="">Select Unit</option>
                                    <option value="per hour">per hour</option>
                                    <option value="per day">per day</option>
                                    <option value="per session">per session</option>
                                    <option value="per visit">per visit</option>
                                    <option value="per week">per week</option>
                                    <option value="per month">per month</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Location" class="form-label">Service Location *</label>
                        <input type="text" class="form-control" id="Location" name="Location" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="AcceptedPetTypes" class="form-label">Accepted Pet Types</label>
                                <input type="text" class="form-control" id="AcceptedPetTypes" name="AcceptedPetTypes" placeholder="e.g., Dog, Cat, Bird">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="AcceptedPetSizes" class="form-label">Accepted Pet Sizes</label>
                                <input type="text" class="form-control" id="AcceptedPetSizes" name="AcceptedPetSizes" placeholder="e.g., Small, Medium, Large">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="MaxPetsPerBooking" class="form-label">Max Pets Per Booking</label>
                                <input type="number" class="form-control" id="MaxPetsPerBooking" name="MaxPetsPerBooking" min="1" value="1">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" checked>
                                    <label class="form-check-label" for="IsActive">
                                        Service is active
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editServiceForm">
                <div class="modal-body">
                    <input type="hidden" id="EditId" name="Id" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditTitle" class="form-label">Service Title *</label>
                                <input type="text" class="form-control" id="EditTitle" name="Title" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditType" class="form-label">Service Type *</label>
                                <select class="form-select" id="EditType" name="Type" required>
                                    <option value="">Select Type</option>
                                    <option value="PetSitting">Pet Sitting</option>
                                    <option value="DogWalking">Dog Walking</option>
                                    <option value="Grooming">Grooming</option>
                                    <option value="Training">Training</option>
                                    <option value="Veterinary">Veterinary</option>
                                    <option value="Boarding">Boarding</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="EditDescription" class="form-label">Description *</label>
                        <textarea class="form-control" id="EditDescription" name="Description" rows="3" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditBasePrice" class="form-label">Base Price *</label>
                                <input type="number" class="form-control" id="EditBasePrice" name="BasePrice" min="0" step="0.01" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditPriceUnit" class="form-label">Price Unit *</label>
                                <input type="text" class="form-control" id="EditPriceUnit" name="PriceUnit" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="EditLocation" class="form-label">Location *</label>
                        <input type="text" class="form-control" id="EditLocation" name="Location" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditAcceptedPetTypes" class="form-label">Accepted Pet Types</label>
                                <input type="text" class="form-control" id="EditAcceptedPetTypes" name="AcceptedPetTypes">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditAcceptedPetSizes" class="form-label">Accepted Pet Sizes</label>
                                <input type="text" class="form-control" id="EditAcceptedPetSizes" name="AcceptedPetSizes">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditMaxPetsPerBooking" class="form-label">Max Pets Per Booking</label>
                                <input type="number" class="form-control" id="EditMaxPetsPerBooking" name="MaxPetsPerBooking" min="1">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" id="EditIsActive" name="IsActive">
                                    <label class="form-check-label" for="EditIsActive">
                                        Service is active
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Edit Service Button Click Handler
            $(document).on('click', '[data-bs-target="#editServiceModal"]', function() {
                console.log("Edit clicked");
                const serviceId = $(this).data('service-id');

                // Fetch service data
                $.get('@Url.Action("GetService")', { id: serviceId })
                    .done(function(response) {
                        if (response.success) {
                            const service = response.service;

                            // Populate the edit form fields using camelCase
                            $('#EditId').val(service.id);
                            $('#EditTitle').val(service.title);
                            $('#EditDescription').val(service.description);
                            $('#EditType').val(service.type);
                            $('#EditBasePrice').val(service.basePrice);
                            $('#EditPriceUnit').val(service.priceUnit);
                            $('#EditLocation').val(service.location);
                            $('#EditAcceptedPetTypes').val(service.acceptedPetTypes);
                            $('#EditAcceptedPetSizes').val(service.acceptedPetSizes);
                            $('#EditMaxPetsPerBooking').val(service.maxPetsPerBooking);
                            $('#EditIsActive').prop('checked', service.isActive);
                        } else {
                            showAlert('danger', response.message || 'Failed to load service data');
                        }
                    })
                    .fail(function() {
                        showAlert('danger', 'An error occurred while loading the service data');
                    });
            });

            // Modal event handlers for proper accessibility
            $('#editServiceModal').on('show.bs.modal', function (e) {
                // Remove aria-hidden when modal is about to show
                $(this).removeAttr('aria-hidden');
            });

            $('#editServiceModal').on('shown.bs.modal', function (e) {
                // Focus on the first input field when modal is shown
                $('#EditTitle').focus();
            });

            $('#editServiceModal').on('hide.bs.modal', function (e) {
                // Add aria-hidden back when modal is being hidden
                $(this).attr('aria-hidden', 'true');
            });

            // Add Service Modal accessibility
            $('#addServiceModal').on('show.bs.modal', function (e) {
                $(this).removeAttr('aria-hidden');
            });

            $('#addServiceModal').on('shown.bs.modal', function (e) {
                $('#Title').focus();
            });

            $('#addServiceModal').on('hide.bs.modal', function (e) {
                $(this).attr('aria-hidden', 'true');
            });

            // Add Service Form
            $('#addServiceForm').on('submit', function(e) {
                e.preventDefault();

                const formData = {
                    Title: $('#Title').val(),
                    Description: $('#Description').val(),
                    Type: $('#Type').val(),
                    BasePrice: parseFloat($('#BasePrice').val()),
                    PriceUnit: $('#PriceUnit').val(),
                    Location: $('#Location').val(),
                    IsActive: $('#IsActive').is(':checked'),
                    AcceptedPetTypes: $('#AcceptedPetTypes').val(),
                    AcceptedPetSizes: $('#AcceptedPetSizes').val(),
                    MaxPetsPerBooking: parseInt($('#MaxPetsPerBooking').val())
                };

                $.post('@Url.Action("CreateService")', formData)
                    .done(function(response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            $('#addServiceModal').modal('hide');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showAlert('danger', response.message);
                        }
                    })
                    .fail(function() {
                        showAlert('danger', 'An error occurred while creating the service');
                    });
            });

            // Edit Service Form
            $('#editServiceForm').on('submit', function(e) {
                e.preventDefault();

                const formData = {
                    Id: parseInt($('#EditId').val()),
                    Title: $('#EditTitle').val(),
                    Description: $('#EditDescription').val(),
                    Type: $('#EditType').val(),
                    BasePrice: parseFloat($('#EditBasePrice').val()),
                    PriceUnit: $('#EditPriceUnit').val(),
                    Location: $('#EditLocation').val(),
                    IsActive: $('#EditIsActive').is(':checked'),
                    AcceptedPetTypes: $('#EditAcceptedPetTypes').val(),
                    AcceptedPetSizes: $('#EditAcceptedPetSizes').val(),
                    MaxPetsPerBooking: parseInt($('#EditMaxPetsPerBooking').val())
                };

                $.post('@Url.Action("UpdateService")', formData)
                    .done(function(response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            $('#editServiceModal').modal('hide');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showAlert('danger', response.message);
                        }
                    })
                    .fail(function() {
                        showAlert('danger', 'An error occurred while updating the service');
                    });
            });

            // Toggle Service Status
            $('.toggle-status').on('click', function() {
                const serviceId = $(this).data('service-id');
                const currentStatus = $(this).data('current-status');
                const action = currentStatus === 'true' ? 'deactivate' : 'activate';

                if (confirm(`Are you sure you want to ${action} this service?`)) {
                    $.post('@Url.Action("ToggleServiceStatus")', { serviceId: serviceId })
                        .done(function(response) {
                            if (response.success) {
                                showAlert('success', response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showAlert('danger', response.message);
                            }
                        })
                        .fail(function() {
                            showAlert('danger', 'An error occurred while updating the service status');
                        });
                }
            });

            // Delete Service
            $('.delete-service').on('click', function() {
                const serviceId = $(this).data('service-id');
                const serviceTitle = $(this).data('service-title');

                if (confirm(`Are you sure you want to delete "${serviceTitle}"? This action cannot be undone.`)) {
                    $.post('@Url.Action("DeleteService")', { serviceId: serviceId })
                        .done(function(response) {
                            if (response.success) {
                                showAlert('success', response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showAlert('danger', response.message);
                            }
                        })
                        .fail(function() {
                            showAlert('danger', 'An error occurred while deleting the service');
                        });
                }
            });

            // Show alert function
            function showAlert(type, message) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                $('.container-fluid').prepend(alertHtml);
            }
        });
    </script>
}