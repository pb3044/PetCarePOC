@{
    ViewData["Title"] = "Customer Reviews";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <div class="row align-items-center mb-5">
        <div class="col-md-7">
            <h1 class="fw-800 mb-1" style="letter-spacing: -1px;">Customer Reviews</h1>
            <p class="text-muted mb-0">What pet owners are saying about your care</p>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                <div class="glass-card px-3 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span class="fw-800">@(ViewBag.AverageRating ?? 0)</span>
                    <span class="text-muted small">/ 5.0</span>
                </div>
                <div class="text-muted small fw-600 me-2">(@(ViewBag.TotalReviews ?? 0) reviews)</div>
                <a href="@Url.Action("Analytics", "ServiceProvider")" class="btn btn-premium btn-sm d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up"></i>
                    <span>Analytics</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        .fw-800 { font-weight: 800; }
        .fw-700 { font-weight: 700; }
        .fw-600 { font-weight: 600; }
        .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .bg-purple-light { background: #f3f0ff; }
        .text-purple { color: #7c4dff; }
        .bg-blue-light { background: #eef2ff; }
        .text-blue { color: #3d5afe; }
        .bg-green-light { background: #f0fdf4; }
        .text-green { color: #22c55e; }
        .bg-orange-light { background: #fff8f1; }
        .text-orange { color: #ff9100; }
        .bg-red-light { background: #fef2f2; }
        .text-red { color: #ef4444; }
    </style>

    <!-- Summary Cards -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 p-3 text-center stats-hover">
                <h3 class="fw-800 mb-1 text-green">@(ViewBag.FiveStarCount ?? 0)</h3>
                <p class="text-muted small fw-600 mb-2">5 Star Reviews</p>
                <div class="d-flex justify-content-center gap-1 text-warning small">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 p-3 text-center stats-hover">
                <h3 class="fw-800 mb-1 text-blue">@(ViewBag.FourStarCount ?? 0)</h3>
                <p class="text-muted small fw-600 mb-2">4 Star Reviews</p>
                <div class="d-flex justify-content-center gap-1 text-warning small">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star text-muted"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 p-3 text-center stats-hover">
                <h3 class="fw-800 mb-1 text-orange">@(ViewBag.ThreeStarCount ?? 0)</h3>
                <p class="text-muted small fw-600 mb-2">3 Star Reviews</p>
                <div class="d-flex justify-content-center gap-1 text-warning small">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star text-muted"></i><i class="bi bi-star text-muted"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card glass-card border-0 p-3 text-center stats-hover">
                <h3 class="fw-800 mb-1 text-red">@((ViewBag.TwoStarCount ?? 0) + (ViewBag.OneStarCount ?? 0))</h3>
                <p class="text-muted small fw-600 mb-2">Below 3 Stars</p>
                <div class="d-flex justify-content-center gap-1 text-warning small">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star text-muted"></i><i class="bi bi-star text-muted"></i><i class="bi bi-star text-muted"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label for="ratingFilter" class="form-label">Filter by Rating</label>
                            <select class="form-select" id="ratingFilter">
                                <option value="">All Ratings</option>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="serviceFilter" class="form-label">Filter by Service</label>
                            <select class="form-select" id="serviceFilter">
                                <option value="">All Services</option>
                                @if (ViewBag.Services != null)
                                {
                                    @foreach (var service in ViewBag.Services)
                                    {
                                        <option value="@service.Id">@service.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="searchReviews" class="form-label">Search Reviews</label>
                            <input type="text" class="form-control" id="searchReviews" placeholder="Search in comments...">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews List -->
    <div class="row">
        <div class="col-12">
            <h5 class="fw-700 mb-4">Latest Feedback</h5>
            @if (ViewBag.Reviews != null && ((IEnumerable<dynamic>)ViewBag.Reviews).Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in ViewBag.Reviews)
                    {
                        <div class="card glass-card border-0 p-4 stats-hover">
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div class="avatar-box bg-purple-light text-purple">
                                            <i class="bi bi-person fw-bold"></i>
                                        </div>
                                        <div>
                                            <div class="fw-700">@review.CustomerName</div>
                                            <div class="text-muted small">@review.CreatedDate.ToString("MMM dd, yyyy")</div>
                                        </div>
                                        <div class="ms-auto d-md-none text-warning">
                                            @for (int i = 1; i <= 5; i++) {
                                                if (i <= review.Rating) { <i class="bi bi-star-fill small"></i> }
                                                else { <i class="bi bi-star small"></i> }
                                            }
                                        </div>
                                    </div>
                                    <div class="d-none d-md-flex text-warning mb-2">
                                        @for (int i = 1; i <= 5; i++) {
                                            if (i <= review.Rating) { <i class="bi bi-star-fill small"></i> }
                                            else { <i class="bi bi-star small"></i> }
                                        }
                                    </div>
                                    <div class="text-muted small mb-2"><i class="bi bi-bag-check me-1"></i> @review.ServiceName</div>
                                    <p class="mb-3 text-dark">@review.Comment</p>
                                    
                                    @if (!string.IsNullOrEmpty(review.Response))
                                    {
                                        <div class="bg-light p-3 rounded-4 mt-2">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-reply-fill text-primary"></i>
                                                <small class="fw-700 text-primary">Your Response</small>
                                            </div>
                                            <p class="mb-0 small text-muted">@review.Response</p>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    @if (string.IsNullOrEmpty(review.Response))
                                    {
                                        <button class="btn btn-outline-primary btn-sm rounded- pill px-4 fw-600" onclick="showResponseModal(@review.Id)">
                                            <i class="bi bi-reply me-1"></i> Respond
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-light btn-sm rounded-pill px-4 fw-600" onclick="editResponse(@review.Id)">
                                            <i class="bi bi-pencil me-1"></i> Edit Response
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <style>
                    .avatar-box {
                        width: 40px;
                        height: 40px;
                        border-radius: 12px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.1rem;
                    }
                </style>
            }
            else
            {
                <div class="glass-card p-5 text-center">
                    <i class="bi bi-star fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No reviews yet</h5>
                    <p class="text-muted mb-0">Complete some services to start receiving feedback.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Response Modal -->
<div class="modal fade" id="responseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Respond to Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="responseForm">
                    <input type="hidden" id="reviewId" name="reviewId">
                    <div class="mb-3">
                        <label for="responseText" class="form-label">Your Response</label>
                        <textarea class="form-control" id="responseText" name="responseText" rows="4"
                                  placeholder="Thank the customer and address any concerns..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitResponse()">Submit Response</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showResponseModal(reviewId) {
            document.getElementById('reviewId').value = reviewId;
            document.getElementById('responseText').value = '';
            var modal = new bootstrap.Modal(document.getElementById('responseModal'));
            modal.show();
        }

        function editResponse(reviewId) {
            // Implement edit response functionality
            showResponseModal(reviewId);
        }

        function submitResponse() {
            var reviewId = document.getElementById('reviewId').value;
            var responseText = document.getElementById('responseText').value;

            if (!responseText.trim()) {
                alert('Please enter a response');
                return;
            }

            // Submit response via AJAX
            // Implementation depends on your backend API
            console.log('Submitting response for review:', reviewId, 'Response:', responseText);

            // Close modal and refresh page
            var modal = bootstrap.Modal.getInstance(document.getElementById('responseModal'));
            modal.hide();
            location.reload();
        }

        // Filter functionality
        document.getElementById('ratingFilter').addEventListener('change', filterReviews);
        document.getElementById('serviceFilter').addEventListener('change', filterReviews);
        document.getElementById('searchReviews').addEventListener('input', filterReviews);

        function filterReviews() {
            // Implement client-side filtering or make AJAX call to server
            console.log('Filtering reviews...');
        }
    </script>
}