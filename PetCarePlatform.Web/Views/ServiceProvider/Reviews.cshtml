@{
    ViewData["Title"] = "Customer Reviews";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Customer Reviews</h1>
                <div class="d-flex align-items-center">
                    <span class="badge bg-warning text-dark fs-6 me-3">
                        <i class="fas fa-star"></i> @ViewBag.AverageRating / 5.0
                    </span>
                    <span class="text-muted">(@ViewBag.TotalReviews reviews)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h3 class="card-title">@ViewBag.FiveStarCount</h3>
                    <p class="card-text">5 Star Reviews</p>
                    <div class="text-warning">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body text-center">
                    <h3 class="card-title">@ViewBag.FourStarCount</h3>
                    <p class="card-text">4 Star Reviews</p>
                    <div class="text-warning">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <h3 class="card-title">@ViewBag.ThreeStarCount</h3>
                    <p class="card-text">3 Star Reviews</p>
                    <div class="text-warning">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <h3 class="card-title">@ViewBag.LowRatingCount</h3>
                    <p class="card-text">Below 3 Stars</p>
                    <div class="text-warning">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label for="ratingFilter" class="form-label">Filter by Rating</label>
                            <select class="form-select" id="ratingFilter">
                                <option value="">All Ratings</option>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="serviceFilter" class="form-label">Filter by Service</label>
                            <select class="form-select" id="serviceFilter">
                                <option value="">All Services</option>
                                @if (ViewBag.Services != null)
                                {
                                    @foreach (var service in ViewBag.Services)
                                    {
                                        <option value="@service.Id">@service.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="searchReviews" class="form-label">Search Reviews</label>
                            <input type="text" class="form-control" id="searchReviews" placeholder="Search in comments...">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews List -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Customer Reviews</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Reviews != null && ((IEnumerable<dynamic>)ViewBag.Reviews).Any())
                    {
                        @foreach (var review in ViewBag.Reviews)
                        {
                            <div class="review-item border-bottom pb-3 mb-3">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center mb-2">
                                            <h6 class="mb-0 me-3">@review.CustomerName</h6>
                                            <div class="text-warning me-3">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star"></i>
                                                    }
                                                }
                                            </div>
                                            <small class="text-muted">@review.CreatedDate.ToString("MMM dd, yyyy")</small>
                                        </div>
                                        <p class="text-muted mb-2"><strong>Service:</strong> @review.ServiceName</p>
                                        <p class="mb-2">@review.Comment</p>
                                        @if (!string.IsNullOrEmpty(review.Response))
                                        {
                                            <div class="response bg-light p-2 rounded mt-2">
                                                <small class="text-muted">Your Response:</small>
                                                <p class="mb-0">@review.Response</p>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-4 text-end">
                                        @if (string.IsNullOrEmpty(review.Response))
                                        {
                                            <button class="btn btn-outline-primary btn-sm" onclick="showResponseModal(@review.Id)">
                                                <i class="fas fa-reply"></i> Respond
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm" onclick="editResponse(@review.Id)">
                                                <i class="fas fa-edit"></i> Edit Response
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Pagination -->
                        <nav aria-label="Reviews pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item">
                                    <a class="page-link" href="#" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-star fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No reviews yet</h5>
                            <p class="text-muted">Complete some services to start receiving customer reviews.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Response Modal -->
<div class="modal fade" id="responseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Respond to Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="responseForm">
                    <input type="hidden" id="reviewId" name="reviewId">
                    <div class="mb-3">
                        <label for="responseText" class="form-label">Your Response</label>
                        <textarea class="form-control" id="responseText" name="responseText" rows="4"
                                  placeholder="Thank the customer and address any concerns..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitResponse()">Submit Response</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showResponseModal(reviewId) {
            document.getElementById('reviewId').value = reviewId;
            document.getElementById('responseText').value = '';
            var modal = new bootstrap.Modal(document.getElementById('responseModal'));
            modal.show();
        }

        function editResponse(reviewId) {
            // Implement edit response functionality
            showResponseModal(reviewId);
        }

        function submitResponse() {
            var reviewId = document.getElementById('reviewId').value;
            var responseText = document.getElementById('responseText').value;

            if (!responseText.trim()) {
                alert('Please enter a response');
                return;
            }

            // Submit response via AJAX
            // Implementation depends on your backend API
            console.log('Submitting response for review:', reviewId, 'Response:', responseText);

            // Close modal and refresh page
            var modal = bootstrap.Modal.getInstance(document.getElementById('responseModal'));
            modal.hide();
            location.reload();
        }

        // Filter functionality
        document.getElementById('ratingFilter').addEventListener('change', filterReviews);
        document.getElementById('serviceFilter').addEventListener('change', filterReviews);
        document.getElementById('searchReviews').addEventListener('input', filterReviews);

        function filterReviews() {
            // Implement client-side filtering or make AJAX call to server
            console.log('Filtering reviews...');
        }
    </script>
}