@model PetCarePlatform.Web.Models.ServiceProviderScheduleViewModel
@{
    ViewData["Title"] = "My Schedule";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h1 class="fw-800 mb-1" style="letter-spacing: -1px;">My Schedule</h1>
            <p class="text-muted mb-0">Manage your availability and appointments</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button type="button" class="btn btn-premium d-flex align-items-center gap-2 ms-auto" data-bs-toggle="modal" data-bs-target="#availabilityModal">
                <i class="bi bi-clock-history"></i>
                <span>Set Availability</span>
            </button>
        </div>
    </div>

    <!-- Statistics Grid -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-purple-light text-purple mx-auto mb-2">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <h4 class="fw-800 mb-0">@Model.Statistics.TodayAppointments</h4>
                <p class="text-muted small fw-600 mb-0">Today</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-blue-light text-blue mx-auto mb-2">
                    <i class="bi bi-calendar-week"></i>
                </div>
                <h4 class="fw-800 mb-0">@Model.Statistics.WeekAppointments</h4>
                <p class="text-muted small fw-600 mb-0">Weekly</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-green-light text-green mx-auto mb-2">
                    <i class="bi bi-check-circle"></i>
                </div>
                <h4 class="fw-800 mb-0">@Model.Statistics.AvailableSlots</h4>
                <p class="text-muted small fw-600 mb-0">Slots</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-orange-light text-orange mx-auto mb-2">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <h4 class="fw-800 mb-0">$@Model.Statistics.TodayEarnings.ToString("N0")</h4>
                <p class="text-muted small fw-600 mb-0">Today $</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-purple-light text-purple mx-auto mb-2">
                    <i class="bi bi-graph-up"></i>
                </div>
                <h4 class="fw-800 mb-0">$@Model.Statistics.WeekEarnings.ToString("N0")</h4>
                <p class="text-muted small fw-600 mb-0">Weekly $</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card glass-card border-0 p-3 stats-hover text-center">
                <div class="icon-box bg-red-light text-red mx-auto mb-2">
                    <i class="bi bi-slash-circle"></i>
                </div>
                <h4 class="fw-800 mb-0">@Model.Statistics.BlockedHours</h4>
                <p class="text-muted small fw-600 mb-0">Blocked</p>
            </div>
        </div>
    </div>

    <style>
        .fw-800 { font-weight: 800; }
        .fw-700 { font-weight: 700; }
        .fw-600 { font-weight: 600; }
        .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .bg-purple-light { background: #f3f0ff; }
        .text-purple { color: #7c4dff; }
        .bg-blue-light { background: #eef2ff; }
        .text-blue { color: #3d5afe; }
        .bg-green-light { background: #f0fdf4; }
        .text-green { color: #22c55e; }
        .bg-orange-light { background: #fff8f1; }
        .text-orange { color: #ff9100; }
        .bg-red-light { background: #fef2f2; }
        .text-red { color: #ef4444; }
        .stats-hover { transition: transform 0.3s ease; border: none; }
        .stats-hover:hover { transform: translateY(-5px); }
    </style>

        <!-- Schedule Controls -->
        <div class="col-12 mb-4">
            <div class="card glass-card border-0 shadow-sm p-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-4 order-2 order-md-1">
                        <div class="btn-group w-100 w-md-auto" role="group">
                            <button type="button" class="btn btn-outline-primary view-btn px-4 fw-600" data-view="day">Day</button>
                            <button type="button" class="btn btn-outline-primary view-btn px-4 fw-600" data-view="week">Week</button>
                            <button type="button" class="btn btn-outline-primary view-btn px-4 fw-600" data-view="month">Month</button>
                        </div>
                    </div>
                    <div class="col-md-4 text-center order-1 order-md-2">
                        <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                            <button type="button" class="btn btn-light rounded-pill px-3" id="prevBtn">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" class="btn btn-light rounded-pill px-4 fw-600" id="todayBtn">Today</button>
                            <button type="button" class="btn btn-light rounded-pill px-3" id="nextBtn">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                        <h4 class="fw-800 text-dark mb-0" id="currentDate">@Model.CurrentDate.ToString("MMMM yyyy")</h4>
                    </div>
                    <div class="col-md-4 text-end order-3">
                        @* Spacer or additional controls *@
                    </div>
                </div>
            </div>
        </div>

        <!-- Calendar -->
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Availability Modal -->
<div class="modal fade" id="availabilityModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Your Availability</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @foreach (var day in Model.Availability)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="form-check">
                                        <input class="form-check-input availability-checkbox" type="checkbox" 
                                               id="available_@day.DayOfWeek" 
                                               data-day="@day.DayOfWeek"
                                               @(day.IsAvailable ? "checked" : "")>
                                        <label class="form-check-label" for="available_@day.DayOfWeek">
                                            <strong>@day.DayName</strong>
                                        </label>
                                    </div>
                                    <div class="row mt-2 availability-times" @(!day.IsAvailable ? "style='display:none;'" : "")>
                                        <div class="col-6">
                                            <label class="form-label">Start Time</label>
                                            <input type="time" class="form-control start-time" 
                                                   data-day="@day.DayOfWeek"
                                                   value="@day.StartTime.ToString(@"hh\:mm")">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">End Time</label>
                                            <input type="time" class="form-control end-time" 
                                                   data-day="@day.DayOfWeek"
                                                   value="@day.EndTime.ToString(@"hh\:mm")">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveAvailability">Save Availability</button>
            </div>
        </div>
    </div>
</div>

<!-- Appointment Details Modal -->
<div class="modal fade" id="appointmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Appointment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="appointmentDetails">
                <!-- Appointment details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/lib/fullcalendar/main.min.css" rel="stylesheet">
    <script src="~/lib/fullcalendar/main.min.js"></script>
    
    <script>
        let currentDate = new Date('@Model.CurrentDate.ToString("yyyy-MM-dd")');
        let currentView = '@Model.CurrentView';
        
        document.addEventListener('DOMContentLoaded', function() {
            initializeCalendar();
            initializeControls();
            initializeAvailability();
        });

        function initializeCalendar() {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: currentView === 'day' ? 'timeGridDay' : 
                            currentView === 'week' ? 'timeGridWeek' : 'dayGridMonth',
                initialDate: currentDate,
                headerToolbar: false,
                height: 'auto',
                slotMinTime: '06:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false,
                slotDuration: '00:30:00',
                events: function(info, successCallback, failureCallback) {
                    loadScheduleData(info.start, info.end, successCallback);
                },
                eventClick: function(info) {
                    showAppointmentDetails(info.event);
                },
                eventDidMount: function(info) {
                    // Add custom styling based on status
                    const status = info.event.extendedProps.status;
                    if (status === 'Confirmed') {
                        info.el.style.backgroundColor = '#28a745';
                    } else if (status === 'Pending') {
                        info.el.style.backgroundColor = '#ffc107';
                    } else if (status === 'Declined') {
                        info.el.style.backgroundColor = '#dc3545';
                    }
                }
            });
            calendar.render();
            window.calendar = calendar;
        }

        function initializeControls() {
            // View buttons
            document.querySelectorAll('.view-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentView = this.dataset.view;
                    updateCalendarView();
                });
            });

            // Navigation buttons
            document.getElementById('prevBtn').addEventListener('click', function() {
                currentDate.setDate(currentDate.getDate() - 1);
                updateCalendar();
            });

            document.getElementById('nextBtn').addEventListener('click', function() {
                currentDate.setDate(currentDate.getDate() + 1);
                updateCalendar();
            });

            document.getElementById('todayBtn').addEventListener('click', function() {
                currentDate = new Date();
                updateCalendar();
            });

            // Set initial active view
            document.querySelector(`[data-view="${currentView}"]`).classList.add('active');
        }

        function initializeAvailability() {
            // Availability checkboxes
            document.querySelectorAll('.availability-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const day = this.dataset.day;
                    const timesDiv = document.querySelector(`.availability-times:has([data-day="${day}"])`);
                    if (this.checked) {
                        timesDiv.style.display = 'block';
                    } else {
                        timesDiv.style.display = 'none';
                    }
                });
            });

            // Save availability
            document.getElementById('saveAvailability').addEventListener('click', function() {
                saveAvailability();
            });
        }

        function loadScheduleData(start, end, successCallback) {
            const viewType = currentView;
            const date = start.toISOString().split('T')[0];

            fetch(`/ServiceProvider/GetScheduleData?date=${date}&viewType=${viewType}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const events = data.appointments.map(appointment => ({
                            id: appointment.id,
                            title: appointment.title,
                            start: appointment.start,
                            end: appointment.end,
                            extendedProps: {
                                status: appointment.status,
                                petOwnerName: appointment.petOwnerName,
                                petName: appointment.petName,
                                totalPrice: appointment.totalPrice
                            }
                        }));
                        successCallback(events);
                    } else {
                        console.error('Failed to load schedule data:', data.message);
                        successCallback([]);
                    }
                })
                .catch(error => {
                    console.error('Error loading schedule data:', error);
                    successCallback([]);
                });
        }

        function updateCalendar() {
            updateCalendarView();
            updateDateDisplay();
        }

        function updateCalendarView() {
            const viewName = currentView === 'day' ? 'timeGridDay' : 
                           currentView === 'week' ? 'timeGridWeek' : 'dayGridMonth';
            window.calendar.changeView(viewName, currentDate);
        }

        function updateDateDisplay() {
            const dateElement = document.getElementById('currentDate');
            if (currentView === 'day') {
                dateElement.textContent = currentDate.toLocaleDateString('en-US', { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
            } else if (currentView === 'week') {
                const endOfWeek = new Date(currentDate);
                endOfWeek.setDate(currentDate.getDate() + 6);
                dateElement.textContent = `${currentDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })} - ${endOfWeek.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`;
            } else {
                dateElement.textContent = currentDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
            }
        }

        function showAppointmentDetails(event) {
            const details = `
                <div class="row">
                    <div class="col-12">
                        <h6>Service: ${event.title}</h6>
                        <p><strong>Pet Owner:</strong> ${event.extendedProps.petOwnerName}</p>
                        <p><strong>Pet:</strong> ${event.extendedProps.petName}</p>
                        <p><strong>Time:</strong> ${event.start.toLocaleString()} - ${event.end.toLocaleString()}</p>
                        <p><strong>Status:</strong> <span class="badge bg-${getStatusColor(event.extendedProps.status)}">${event.extendedProps.status}</span></p>
                        <p><strong>Total Price:</strong> $${event.extendedProps.totalPrice}</p>
                    </div>
                </div>
            `;
            document.getElementById('appointmentDetails').innerHTML = details;
            new bootstrap.Modal(document.getElementById('appointmentModal')).show();
        }

        function getStatusColor(status) {
            switch (status) {
                case 'Confirmed': return 'success';
                case 'Pending': return 'warning';
                case 'Declined': return 'danger';
                default: return 'secondary';
            }
        }

        function saveAvailability() {
            const availabilityData = [];
            
            document.querySelectorAll('.availability-checkbox').forEach(checkbox => {
                const day = checkbox.dataset.day;
                const isAvailable = checkbox.checked;
                const startTime = document.querySelector(`.start-time[data-day="${day}"]`).value;
                const endTime = document.querySelector(`.end-time[data-day="${day}"]`).value;

                availabilityData.push({
                    dayOfWeek: parseInt(day),
                    isAvailable: isAvailable,
                    startTime: startTime,
                    endTime: endTime
                });
            });

            fetch('/ServiceProvider/UpdateAvailability', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(availabilityData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert('Availability updated successfully!', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('availabilityModal')).hide();
                } else {
                    showAlert('Failed to update availability: ' + data.message, 'danger');
                }
            })
            .catch(error => {
                console.error('Error saving availability:', error);
                showAlert('An error occurred while saving availability', 'danger');
            });
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.row'));
            
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    </script>
}