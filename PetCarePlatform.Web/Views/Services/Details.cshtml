@model PetCarePlatform.Core.Models.Service
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Services")">Services</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <!-- Service Details -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">@Model.Title</h4>
                        <span class="badge bg-primary fs-6">@Model.Type.ToString()</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Location</h6>
                            <p><i class="fas fa-map-marker-alt me-2"></i>@Model.Location</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Price</h6>
                            <p class="h5 text-primary mb-0">$@Model.BasePrice.ToString("F2") <small class="text-muted">@Model.PriceUnit</small></p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted mb-2">Description</h6>
                        <p>@Model.Description</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Accepted Pet Types</h6>
                            <p>@Model.AcceptedPetTypes</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Accepted Pet Sizes</h6>
                            <p>@Model.AcceptedPetSizes</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Maximum Pets per Booking</h6>
                            <p><i class="fas fa-paw me-2"></i>@Model.MaxPetsPerBooking pets</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Service Status</h6>
                            <p>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>Inactive</span>
                                }
                            </p>
                        </div>
                    </div>

                    @if (Model.Provider != null)
                    {
                        <hr>
                        <div class="mb-4">
                            <h6 class="text-muted mb-3">Service Provider</h6>
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    @if (!string.IsNullOrEmpty(Model.Provider.User?.ProfilePhotoUrl))
                                    {
                                        <img src="@Model.Provider.User.ProfilePhotoUrl" class="rounded-circle" width="60" height="60" alt="Provider" />
                                    }
                                    else
                                    {
                                        <div class="bg-gradient-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="fas fa-user text-white fa-2x"></i>
                                        </div>
                                    }
                                </div>
                                <div>
                                    <h6 class="mb-1">@Model.Provider.BusinessName</h6>
                                    <p class="text-muted mb-1">@Model.Provider.Description</p>
                                    @if (Model.Provider.AverageRating > 0)
                                    {
                                        <div class="text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Model.Provider.AverageRating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i - 0.5 <= Model.Provider.AverageRating)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                            <span class="text-muted ms-2">(@Model.Provider.TotalReviews reviews)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Reviews Section -->
            @if (Model.Reviews?.Any() == true)
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Reviews</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var review in Model.Reviews.Take(5))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-1">@review.Reviewer?.FirstName @review.Reviewer?.LastName</h6>
                                        <div class="text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <p class="mb-1">@review.Comment</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Booking Sidebar -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Book This Service</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h4 class="text-primary mb-2">$@Model.BasePrice.ToString("F2")</h4>
                        <p class="text-muted">@Model.PriceUnit</p>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("PetOwner"))
                        {
                            <a href="@Url.Action("BookService", "PetOwner", new { serviceId = Model.Id })" class="btn btn-primary w-100 mb-3">
                                <i class="fas fa-calendar-plus me-2"></i>Book Now
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                Only pet owners can book services.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Please <a href="@Url.Action("Login", "Account")">login</a> to book this service.
                        </div>
                    }

                    <hr>

                    <div class="mb-3">
                        <h6 class="text-muted mb-2">Service Details</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-paw me-2"></i>Max @Model.MaxPetsPerBooking pets</li>
                            <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i>@Model.Location</li>
                            <li class="mb-2"><i class="fas fa-clock me-2"></i>@Model.Type.ToString()</li>
                        </ul>
                    </div>

                    @if (Model.Provider != null)
                    {
                        <div class="mb-3">
                            <h6 class="text-muted mb-2">Provider Info</h6>
                            <ul class="list-unstyled">
                                @if (Model.Provider.BackgroundCheckVerified)
                                {
                                    <li class="mb-1"><i class="fas fa-shield-alt text-success me-2"></i>Background Check Verified</li>
                                }
                                @if (Model.Provider.IdentityVerified)
                                {
                                    <li class="mb-1"><i class="fas fa-id-card text-success me-2"></i>Identity Verified</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.Provider.InsuranceInfo))
                                {
                                    <li class="mb-1"><i class="fas fa-umbrella text-success me-2"></i>Insured</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <!-- Contact Provider -->
            @if (User.Identity.IsAuthenticated && User.IsInRole("PetOwner") && Model.Provider != null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Contact Provider</h5>
                    </div>
                    <div class="card-body">
                        <a href="@Url.Action("Contact", "Messages", new { providerId = Model.Provider.Id })" class="btn btn-outline-primary w-100">
                            <i class="fas fa-envelope me-2"></i>Send Message
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
