<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetCare - Connecting Pet Owners with Trusted Care Providers</title>
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <link href="~/fonts/outfit/outfit.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
   
    <style>
        :root {
            --primary-hsl: 245, 75%, 65%;
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.3);
            --text-dark: #1a1c1e;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
            color: var(--text-dark);
            overflow-x: hidden;
        }

        /* Premium Nav */
        .header {
            background: transparent;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            padding: 1rem 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .header.scrolled {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            padding: 0.6rem 0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border-bottom: 1px solid var(--glass-border);
        }

        .nav-link {
            font-weight: 600;
            color: white !important;
            transition: all 0.3s ease;
            position: relative;
        }

        .header.scrolled .nav-link {
            color: var(--text-dark) !important;
        }

        .logo {
            font-weight: 800;
            font-size: 1.5rem;
            color: white !important;
        }

        .header.scrolled .logo {
            color: var(--text-dark) !important;
        }

        .btn-nav-primary {
            background: #667eea;
            color: white !important;
            border-radius: 50px;
            padding: 0.6rem 1.8rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-nav-outline {
            border: 2px solid white;
            color: white !important;
            border-radius: 50px;
            padding: 0.6rem 1.8rem;
            font-weight: 700;
        }

        .header.scrolled .btn-nav-outline {
            border-color: #667eea;
            color: #667eea !important;
        }

        /* Main Content */
        main {
            min-height: calc(100vh - 200px);
        }

        /* Utilities */
        .fw-800 { font-weight: 800; }

        /* Footer */
        .footer {
            background: #2d3748;
            color: white;
            padding: 60px 0 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 3rem;
            margin-bottom: 2rem;
        }

        .footer-section h3 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }

        .footer-section ul {
            list-style: none;
            padding: 0;
        }

        .footer-section ul li {
            margin-bottom: 0.8rem;
        }

        .footer-section ul li a {
            color: #a0aec0;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-section ul li a:hover {
            color: #667eea;
        }

        .footer-bottom {
            border-top: 1px solid #4a5568;
            padding-top: 2rem;
            text-align: center;
            color: #a0aec0;
        }

        .social-icons {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .social-icons a {
            width: 40px;
            height: 40px;
            background: #4a5568;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-icons a:hover {
            background: #667eea;
            transform: translateY(-2px);
        }

        @@media (max-width: 991px) {
            .footer-content {
                gap: 2rem;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="logo d-flex align-items-center text-decoration-none" href="@Url.Action("Index", "Home")">
                <i class="bi bi-heart-pulse-fill text-danger me-2"></i>
                <span>PetCare</span>
            </a>

            <div class="d-none d-lg-flex align-items-center gap-4">
                <a class="nav-link text-decoration-none" href="@Url.Action("Index", "Home")">Home</a>
                <a class="nav-link text-decoration-none" href="@Url.Action("Search", "Services")">Search Services</a>
                <a class="nav-link text-decoration-none" href="@Url.Action("Index", "Services")">All Services</a>
                
                <div class="ms-4 d-flex gap-2">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-nav-outline text-decoration-none">Login</a>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-nav-primary text-decoration-none">Sign Up</a>
                </div>
            </div>

            <!-- Mobile Actions -->
            <div class="d-flex d-lg-none align-items-center gap-2">
                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-nav-outline py-2 px-3">Login</a>
                <button class="btn text-white fs-2 p-0 ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Overlay -->
        <div class="collapse d-lg-none position-fixed top-0 start-0 w-100 h-100 z-3" id="mobileNav">
            <div class="bg-dark h-100 p-4 d-flex flex-column align-items-center justify-content-center gap-4">
                <button class="btn btn-close btn-close-white position-absolute top-0 end-0 m-4" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav"></button>
                <a class="nav-link fs-2 fw-800" href="@Url.Action("Index", "Home")">Home</a>
                <a class="nav-link fs-2 fw-800" href="@Url.Action("Search", "Services")">Search Services</a>
                <a class="nav-link fs-2 fw-800" href="@Url.Action("Index", "Services")">All Services</a>
                <hr class="w-50 border-white-50">
                <a href="@Url.Action("Login", "Account")" class="btn btn-nav-outline px-5 py-3 fs-4">Login</a>
                <a href="@Url.Action("Register", "Account")" class="btn btn-nav-primary px-5 py-3 fs-4">Sign Up</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>PetCare</h3>
                    <p>Connecting pet owners with trusted pet care providers in your neighborhood.</p>
                    <div class="social-icons">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="footer-section">
                    <h3>For Pet Owners</h3>
                    <ul>
                        <li><a href="@Url.Action("Search", "Services")">Find Services</a></li>
                        <li><a href="#">Book a Service</a></li>
                        <li><a href="#">How It Works</a></li>
                        <li><a href="#">Safety</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>For Providers</h3>
                    <ul>
                        <li><a href="#">Become a Provider</a></li>
                        <li><a href="#">Provider Portal</a></li>
                        <li><a href="#">Resources</a></li>
                        <li><a href="#">Support</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Support</h3>
                    <ul>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 PetCare. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(window).scroll(function() {
            if ($(this).scrollTop() > 50) {
                $('.header').addClass('scrolled');
            } else {
                $('.header').removeClass('scrolled');
            }
        });
        
        // Auto-close mobile nav on link click
        $('#mobileNav .nav-link, #mobileNav .btn').click(function() {
            var bsCollapse = new bootstrap.Collapse(document.getElementById('mobileNav'), {
              toggle: false
            });
            bsCollapse.hide();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>