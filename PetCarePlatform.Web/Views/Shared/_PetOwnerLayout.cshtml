<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pet Care Services</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-light">
    <!-- Top Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">
                <i class="fas fa-paw me-2"></i>PetCare
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/PetOwner/Dashboard">
                            <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/PetOwner/MyBookings">
                            <i class="fas fa-calendar me-1"></i>My Bookings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/PetOwner/MyPets">
                            <i class="fas fa-heart me-1"></i>My Pets
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Services">
                            <i class="fas fa-search me-1"></i>Browse Services
                        </a>
                    </li>
                </ul>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <div class="avatar-sm bg-white bg-opacity-25 rounded-circle me-2 d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-white"></i>
                            </div>
                            <span>@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/PetOwner/Profile">
                                    <i class="fas fa-user me-2"></i>My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/PetOwner/Settings">
                                    <i class="fas fa-cog me-2"></i>Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                           @*  <li>
                                <a class="dropdown-item" href="/Account/Logout">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a>
                            </li> *@
                            <li>
                                <a class="dropdown-item" href="#" onclick="document.getElementById('logoutForm').submit(); return false;">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">
                        <i class="fas fa-paw me-2"></i>PetCare Services
                    </h6>
                    <p class="text-muted small mb-0">
                        Your trusted partner for all pet care needs. Book professional services for your beloved pets.
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-dark mb-3">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/Services" class="text-decoration-none text-muted">Browse Services</a></li>
                        <li><a href="/PetOwner/MyBookings" class="text-decoration-none text-muted">My Bookings</a></li>
                        <li><a href="/PetOwner/MyPets" class="text-decoration-none text-muted">My Pets</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="text-dark mb-3">Support</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/Support/Help" class="text-decoration-none text-muted">Help Center</a></li>
                        <li><a href="/Support/Contact" class="text-decoration-none text-muted">Contact Us</a></li>
                        <li><a href="/Support/FAQ" class="text-decoration-none text-muted">FAQ</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-muted small mb-0">
                        © 2025 PetCare Services. All rights reserved.
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <div class="d-flex justify-content-end gap-3">
                        <a href="#" class="text-muted">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="text-muted">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="text-muted">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: none;">
    </form>
</body>
</html>

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }

    .navbar-brand {
        font-size: 1.5rem;
    }

    .dropdown-menu {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 0.375rem;
    }

    footer a:hover {
        color: var(--bs-primary) !important;
    }
</style>